{%- comment -%}
  New York Bagel Express logo (theme asset).
  Used by the header when no logo is chosen in Theme settings > Logo.
  Uploading a logo in the Theme Editor overrides this automatically.
  Accepts: class (string)
{%- endcomment -%}
{%- liquid
  assign logo_w = settings.logo_width | default: 170
  assign logo_h = logo_w | times: 328 | divided_by: 776
-%}
<div class="header__heading-logo-wrapper">
  <img
    src="{{ 'nybe-logo-400.webp' | asset_url }}"
    srcset="{{ 'nybe-logo-400.webp' | asset_url }} 400w, {{ 'nybe-logo-776.webp' | asset_url }} 776w"
    sizes="{{ logo_w }}px"
    width="{{ logo_w }}"
    height="{{ logo_h }}"
    alt="{{ shop.name | escape }}"
    class="{{ class | default: 'header__heading-logo' }}"
    fetchpriority="high"
  >
</div>
