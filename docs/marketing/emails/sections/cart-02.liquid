tion" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #ECDCC4;"><tr>{%- if item.image_url != blank -%}<td width="96" style="padding:14px 14px 14px 0;"><img src="{{ item.image_url | escape }}" alt="{{ item.product_title | escape }}" width="80" style="display:block;width:80px;height:auto;border-radius:12px;"></td>{%- endif -%}<td style="padding:14px 0;font-size:16px;color:#082D5C;"><strong>{{ item.product_title | escape }}</strong>{% if item.variant_title != blank and item.variant_title != 'Default Title' %}<br>{{ item.variant_title | escape }}{% endif %}<br><span style="font-size:14px;color:#4A5A70;">Quantity: {{ item.quantity }}</span></td></tr></table>{%- endfor -%}{%- if abandoned_checkout.remaining_products_count > 0 -%}<p style="font-size:14px;">Plus {{ abandoned_checkout.remaining_products_count }} more item(s) in your checkout.</p>{%- endif -%}{%- elsif abandoned_visit.products_added_to_cart != blank -%}<h2 style="margin:28px 0 8px;font-size:20px;font-weight:900;text-transform:uppercase;color:#082D5C;">Your box</h2>{%- for item in abandoned_visit.products_added_to_cart -%}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-top:1px solid #ECDCC4;"><tr>{%- if item.image_url != blank -%}<td width="96" style="padding:14px 14px 14px 0;"><img src="{{ item.image_url | escape }}" alt="{{ item.title | escape }}" width="80" style="display:block;width:80px;height:auto;border-radius:12px;"></td>{%- endif -%}<td style="padding:14px 0;font-size:16px;color:#082D5C;"><strong>{{ item.title | escape }}</strong>{% if item.variant_title != blank and item.variant_title != 'Default Title' %}<br>{{ item.variant_title | escape }}{% endif %}<br><span style="font-size:14px;color:#4A5A70;">Quantity: {{ item.quantity }}</span></td></tr></table>{%- endfor -%}{%- if abandoned_visit.remaining_cart_products_count > 0 -%}<p style="font-size:14px;">Plus {{ abandoned_visit.remaining_cart_products_count }} more item(s) in your cart.</p>{%- endif -%}{%- endif -%}<h2 style="margin:24px 0 8px;font-size:20px;font-weight:900;text-transform:uppercase;color:#082D5C;">Can&rsquo;t eat them all today?</h2><p>We don&rsquo;t use preservatives, so enjoy your bagels within 24 hours and freeze the rest. When you&rsquo;re ready, microwave for 30 seconds, toast, and enjoy.</p><table role="presentation" cellpadding="0" cellspacing="0" style="margin:26px auto;"><tr><td align="center" bgcolor="#C9420C" style="border-radius:999px;background:#C9420C;"><a href="{{ recovery_url | escape }}" style="display:inline-block;padding:18px 40px;font-size:16px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;color:#FFFFFF;text-decoration:none;border-radius:999px;">Return to your box &rarr;</a></td></tr></table><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:6px 0 22px;"><tr><td align="center" style="background:#FFF4E2;border-radius:14px;padding:18px 20px;border-left:5px solid #F47B20;"><div style="font-size:18px;font-weight:900;letter-spacing:.5px;text-transform:uppercase;color:#082D5C;">Hand-rolled in New York</div><div style="font-size:13px;line-height:1.5;color:#4A5A70;margin-top:4px;">Your dozen, your way: 3 sleeves of 4, up to 3 flavors.</div></td></tr></table><p style="font-size:15px;margin:8px 0 4px;">Questions before you order? Just reply or visit our contact page.</p><p style="font-size:15px;margin:0 0 22px;">&mdash; The New York Bagel Express Team</p></td></tr><tr><td style="background:#082D5C;padding:22px 40px;font-size:13px;line-height:1.6;color:#FFFFFF;"><strong style="letter-spacing:1px;">FROM NEW YORK TO YOUR DOOR.</strong><br>We ship Monday&ndash;Wednesday from our commissary on Long Island, NY. Orders placed Wednesday&ndash;Sunday ship the following Monday.<br><a href="https://nybagelexpress.com/pages/contact" style="color:#F47B20;font-weight:bold;">Questions? We&rsquo;re here to help.</a></td></tr></table>