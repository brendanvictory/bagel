{%- comment -%} New York Bagel Express — Image + text (image left/right, placeholder when empty, optional checklist blocks) {%- endcomment -%}
<section
  id="{{ section.settings.anchor | default: section.id | handleize }}"
  class="bbb-imgtext color-{{ section.settings.color_scheme | default: 'scheme-1' }} gradient"
  style="--bbb-pad-top: {{ section.settings.padding_top }}px; --bbb-pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="bbb-imgtext-{{ section.id }}"
>
  <div class="page-width bbb-section bbb-imgtext__grid bbb-imgtext__grid--{{ section.settings.image_position }}">
    <div class="bbb-imgtext__media">
      {%- if section.settings.bundled_photo == 'delivery-box' -%}
        {%- comment -%} Bundled theme photo (pre-cropped 4:3 WebP, lazy, responsive) — overrides the picked image {%- endcomment -%}
        <div class="bbb-ph" style="--bbb-ph-ratio: {{ section.settings.ratio | default: '4 / 3' }};">
          <img class="bbb-ph__img" src="{{ 'nybe-delivery-box-1000.webp' | asset_url }}"
            srcset="{{ 'nybe-delivery-box-480.webp' | asset_url }} 480w, {{ 'nybe-delivery-box-720.webp' | asset_url }} 720w, {{ 'nybe-delivery-box-1000.webp' | asset_url }} 1000w, {{ 'nybe-delivery-box-1367.webp' | asset_url }} 1367w"
            sizes="(min-width: 990px) 45vw, 100vw" width="1367" height="1025" loading="lazy" decoding="async"
            alt="{{ section.settings.image_alt | default: 'A New York Bagel Express box on a front doorstep' | escape }}">
        </div>
      {%- else -%}
        {%- render 'bbb-image-placeholder', image: section.settings.image, alt: section.settings.image_alt, sizes: '(min-width: 990px) 45vw, 100vw', ratio: section.settings.ratio -%}
      {%- endif -%}
    </div>
    <div class="bbb-imgtext__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="bbb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="bbb-imgtext-{{ section.id }}" class="bbb-display bbb-display--l">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <span class="bbb-accent">{{ section.settings.heading_accent | escape }}</span>{%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}<div class="rte bbb-imgtext__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="bbb-checklist" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="bbb-checklist__icon" aria-hidden="true"></span>
              <span><strong>{{ block.settings.title | escape }}</strong>{% if block.settings.text != blank %} — {{ block.settings.text | escape }}{% endif %}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <div class="bbb-cta-row">
          <a href="{{ section.settings.cta_link | default: '/products/build-your-box' }}" class="button button--primary">{{ section.settings.cta_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BBB Image + text",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "A placeholder shows until you choose one." },
    { "type": "select", "id": "bundled_photo", "label": "Bundled photo", "default": "none", "info": "Uses a photo shipped with the theme (fast WebP) instead of the image above.", "options": [ { "value": "none", "label": "None (use image above)" }, { "value": "delivery-box", "label": "Delivery box on doorstep" } ] },
    { "type": "text", "id": "image_alt", "label": "Image description (alt text)" },
    {
      "type": "select", "id": "image_position", "label": "Image position", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ]
    },
    {
      "type": "select", "id": "ratio", "label": "Image shape", "default": "4 / 3",
      "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 3", "label": "Landscape" }, { "value": "4 / 5", "label": "Portrait" } ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (Carolina blue)" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "anchor", "label": "Anchor for links" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Checklist item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Point" },
        { "type": "text", "id": "text", "label": "Detail" }
      ]
    }
  ],
  "presets": [ { "name": "BBB Image + text" } ]
}
{% endschema %}
