{%- comment -%} Bad Boy Bagel Co. — Our process: horizontal timeline (vertical on mobile) {%- endcomment -%}
<section
  id="{{ section.settings.anchor | default: 'process' | handleize }}"
  class="bbb-process color-{{ section.settings.color_scheme }} gradient{% if section.settings.spray %} bbb-spray{% endif %}"
  style="--bbb-pad-top: {{ section.settings.padding_top }}px; --bbb-pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="bbb-process-heading-{{ section.id }}"
>
  <div class="page-width bbb-section">
    <header class="bbb-section__header">
      {%- if section.settings.eyebrow != blank -%}<p class="bbb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="bbb-process-heading-{{ section.id }}" class="bbb-display bbb-display--l">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </header>
    <ol class="bbb-process__list" role="list">
      {%- for block in section.blocks -%}
        <li class="bbb-process__item" {{ block.shopify_attributes }}>
          <span class="bbb-process__dot" aria-hidden="true"></span>
          {%- if block.settings.kicker != blank -%}<p class="bbb-process__kicker">{{ block.settings.kicker | escape }}</p>{%- endif -%}
          <h3 class="bbb-process__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "BBB Our process",
  "tag": "div",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From our oven to your freezer." },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "text", "id": "anchor", "label": "Anchor for links", "default": "process" },
    { "type": "checkbox", "id": "spray", "label": "Spray-paint dots", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker (e.g., Day 1)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Stage" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [ { "name": "BBB Our process" } ]
}
{% endschema %}
