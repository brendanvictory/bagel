{%- comment -%}
  New York Bagel Express — slim navy trust bar above the header (desktop/tablet only).
  Only claims the business can back up — no ratings unless they cite a real, named review source.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="nybe-trust" role="region" aria-label="{{ section.settings.label | escape }}">
  <ul class="page-width nybe-trust__list" role="list">
    {%- for block in section.blocks -%}
      <li class="nybe-trust__item" {{ block.shopify_attributes }}>
        {%- render 'bbb-icon', name: block.settings.icon, size: 18, class: 'nybe-trust__icon' -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
        {%- else -%}
          <span>{{ block.settings.text | escape }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>
{%- endif -%}

{% schema %}
{
  "name": "NYBE Trust bar",
  "tag": "div",
  "class": "section-nybe-trust",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Why shop with us" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Message",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck" }, { "value": "package", "label": "Package" }, { "value": "star", "label": "Star" },
            { "value": "leaf", "label": "Leaf" }, { "value": "flame", "label": "Flame" }, { "value": "map-pin", "label": "Map pin" },
            { "value": "heart", "label": "Heart" }, { "value": "check-circle", "label": "Check" }, { "value": "calendar", "label": "Calendar" },
            { "value": "chef-hat", "label": "Chef hat" }, { "value": "award", "label": "Award" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Shipped Nationwide", "info": "Only claims you can back up. A rating must name its real source." },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] },
  "presets": [ { "name": "NYBE Trust bar" } ]
}
{% endschema %}
