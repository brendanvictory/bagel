{%- comment -%}
  Bad Boy Bagel Co. — Hero
  Layouts:
    background — full-bleed photo (e.g., bagel assortment) behind the copy,
                 with an adjustable dark overlay for legibility. Optional
                 separate mobile crop. Focal point set in Shopify Files is used.
    split      — copy beside an image (or logo art).
  Headline is the page H1 on the homepage. Price line is read live from a
  chosen product. Optional mobile sticky CTA.
{%- endcomment -%}
{%- liquid
  assign box = section.settings.price_product
  assign heading_tag = section.settings.heading_tag
  if request.page_type == 'product' and heading_tag == 'h1'
    assign heading_tag = 'h2'
  endif

  assign layout = section.settings.layout
  assign bg = section.settings.image
  assign bg_mobile = section.settings.image_mobile | default: section.settings.image
  assign has_bg = false
  assign use_bundled = false
  if layout == 'background'
    if bg != blank
      assign has_bg = true
    elsif section.settings.use_bundled_photo
      assign has_bg = true
      assign use_bundled = true
    endif
  endif
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
-%}
<section
  id="bbb-hero-{{ section.id }}"
  class="bbb-hero bbb-hero--{{ layout }} bbb-hero--align-{{ section.settings.text_align }} bbb-hero--h-{{ section.settings.height }} color-{{ section.settings.color_scheme | default: 'scheme-5' }} gradient{% if section.settings.spray and has_bg == false %} bbb-spray{% endif %}{% if has_bg %} bbb-hero--has-bg{% endif %}"
  style="--bbb-pad-top: {{ section.settings.padding_top }}px; --bbb-pad-bottom: {{ section.settings.padding_bottom }}px; --bbb-overlay: {{ overlay }};"
  aria-labelledby="bbb-hero-heading-{{ section.id }}"
>
  {%- if has_bg -%}
    {%- comment -%} One <picture>: phones download only the mobile crop (if set), desktops only the wide image. {%- endcomment -%}
    <div class="bbb-hero__bg" aria-hidden="true">
      {%- if use_bundled -%}
        {%- comment -%} Owner-supplied bagel photo shipped with the theme (assets/bbb-hero-bagels-*). {%- endcomment -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="{{ 'bbb-hero-bagels-mobile-480.webp' | asset_url }} 480w, {{ 'bbb-hero-bagels-mobile-614.webp' | asset_url }} 614w"
            sizes="100vw"
          >
          <img
            src="{{ 'bbb-hero-bagels-1024.webp' | asset_url }}"
            srcset="{{ 'bbb-hero-bagels-768.webp' | asset_url }} 768w, {{ 'bbb-hero-bagels-1024.webp' | asset_url }} 1024w"
            sizes="100vw"
            width="1024"
            height="768"
            alt=""
            class="bbb-hero__bg-img"
            style="object-position: 55% 55%;"
            fetchpriority="high"
            loading="eager"
          >
        </picture>
      {%- else -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{% for w in (1..5) %}{% assign px = w | times: 250 | plus: 250 %}{{ bg_mobile | image_url: width: px }} {{ px }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
            sizes="100vw"
          >
        {%- endif -%}
        <img
          src="{{ bg | image_url: width: 1500 }}"
          srcset="{% for w in (1..7) %}{% assign px = w | times: 300 | plus: 75 %}{{ bg | image_url: width: px }} {{ px }}w, {% endfor %}{{ bg | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          width="{{ bg.width }}"
          height="{{ bg.height }}"
          alt=""
          class="bbb-hero__bg-img"
          style="object-position: {{ bg.presentation.focal_point | default: '50% 50%' }};"
          fetchpriority="high"
          loading="eager"
        >
      </picture>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- liquid
    assign solo = false
    if layout == 'background'
      assign solo = true
    elsif section.settings.image == blank and section.settings.show_logo_art == false
      assign solo = true
    endif
  -%}
  <div class="page-width bbb-section bbb-hero__grid{% if solo %} bbb-hero__grid--solo{% endif %}">
    <div class="bbb-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="bbb-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <{{ heading_tag }} id="bbb-hero-heading-{{ section.id }}" class="bbb-display bbb-display--xl">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %}
          <span class="bbb-accent">{{ section.settings.heading_accent | escape }}</span>
        {%- endif -%}
      </{{ heading_tag }}>

      {%- if section.settings.subheading != blank -%}
        <div class="bbb-hero__sub rte">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if box != blank and section.settings.show_price -%}
        {%- liquid
          assign v = box.selected_or_first_available_variant
          assign sub_price = nil
          for alloc in v.selling_plan_allocations
            if sub_price == nil or alloc.price < sub_price
              assign sub_price = alloc.price
            endif
          endfor
        -%}
        <p class="bbb-hero__price">
          {%- if sub_price != nil and sub_price < v.price -%}
            <strong>{{ sub_price | money }}</strong> per box with subscribe &amp; save
            <span class="bbb-hero__price-alt">or {{ v.price | money }} one-time</span>
          {%- else -%}
            <strong>{{ v.price | money }}</strong> per box
          {%- endif -%}
        </p>
      {%- endif -%}

      <div class="bbb-cta-row">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="button button--primary" id="bbb-hero-cta-{{ section.id }}">
            {{- section.settings.cta_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_link | default: '#how-it-works' }}" class="button button--secondary">
            {{- section.settings.cta2_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="bbb-hero__chips" role="list">
          {%- for block in section.blocks -%}
            <li class="bbb-chip" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if layout == 'split' -%}
      {%- if section.settings.image != blank -%}
        <div class="bbb-hero__media">
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '375, 550, 750, 1000, 1400',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'bbb-hero__img'
          }}
        </div>
      {%- elsif section.settings.show_logo_art -%}
        <div class="bbb-hero__media bbb-hero__media--logo" aria-hidden="true">
          <img
            src="{{ 'bbb-logo-1200.webp' | asset_url }}"
            srcset="{{ 'bbb-logo-600.webp' | asset_url }} 600w, {{ 'bbb-logo-1200.webp' | asset_url }} 1200w"
            sizes="(min-width: 990px) 45vw, 90vw"
            width="1200" height="863" alt="" fetchpriority="high"
          >
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- if layout == 'background' and has_bg == false and request.design_mode -%}
    <p class="bbb-editor-note bbb-hero__note">Add a bagel assortment photo in this section's “Background image” setting.</p>
  {%- endif -%}
</section>

{%- if section.settings.sticky_cta and section.settings.cta_label != blank -%}
  <div class="bbb-sticky-cta color-{{ section.settings.sticky_color_scheme | default: 'scheme-3' }}" data-bbb-sticky="{{ section.id }}" hidden>
    <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="button button--primary">
      {{- section.settings.cta_label | escape -}}
    </a>
  </div>
  <script src="{{ 'bbb-sticky-cta.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "BBB Hero",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select", "id": "layout", "label": "Layout", "default": "background",
      "options": [
        { "value": "background", "label": "Photo background" },
        { "value": "split", "label": "Copy beside image" }
      ]
    },
    {
      "type": "select", "id": "text_align", "label": "Text alignment", "default": "center",
      "options": [ { "value": "center", "label": "Center" }, { "value": "left", "label": "Left" } ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New York bagels, shipped." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (Carolina blue)", "default": "bad boy box" },
    {
      "type": "select", "id": "heading_tag", "label": "Heading level", "default": "h1",
      "info": "Use H1 for the first hero on the homepage only.",
      "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" } ]
    },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Pick 3 sleeves. 4 bagels each. Your flavors, your rules.</p>" },
    {
      "type": "product", "id": "price_product", "label": "Show price from product",
      "info": "Price and subscribe & save price are read live from this product. Nothing is typed in by hand."
    },
    { "type": "checkbox", "id": "show_price", "label": "Show price line", "default": true },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_label", "label": "Primary button label", "default": "Build your box" },
    { "type": "url", "id": "cta_link", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "How it works" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link" },
    { "type": "header", "content": "Image" },
    {
      "type": "image_picker", "id": "image", "label": "Background / main image",
      "info": "Photo background: an assortment of your bagels, at least 2400px wide. Set the focal point in Content > Files so the crop keeps the bagels in view."
    },
    {
      "type": "checkbox", "id": "use_bundled_photo", "label": "Use the bundled bagel assortment photo when no image is chosen", "default": true
    },
    {
      "type": "image_picker", "id": "image_mobile", "label": "Mobile background image (optional)",
      "info": "A taller crop for phones. Uses the main image when empty."
    },
    {
      "type": "range", "id": "overlay_opacity", "label": "Overlay darkness", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55,
      "info": "Keep high enough that white text stays readable over busy areas of the photo."
    },
    {
      "type": "select", "id": "height", "label": "Height (photo background)", "default": "medium",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    { "type": "checkbox", "id": "show_logo_art", "label": "Copy beside image: show logo art when no image", "default": true },
    { "type": "header", "content": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "info": "Use a dark scheme for photo backgrounds so text stays light.", "default": "scheme-5" },
    { "type": "checkbox", "id": "spray", "label": "Spray-paint dots (no-photo only)", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "header", "content": "Mobile sticky button" },
    { "type": "checkbox", "id": "sticky_cta", "label": "Show sticky button on mobile after scrolling past hero", "default": true },
    { "type": "color_scheme", "id": "sticky_color_scheme", "label": "Sticky bar color scheme", "default": "scheme-3" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Trust chip",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Sleeves of 4", "info": "Only claims you can back up (no unverified shipping speeds, awards or guarantees)." }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBB Hero",
      "blocks": []
    }
  ]
}
{% endschema %}
