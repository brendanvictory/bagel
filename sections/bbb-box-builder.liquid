{%- comment -%}
  New York Bagel Express — Build Your Box (ADR-002 Option C), two pages:
    Page 1  Pick your sleeves (flavor photo grid, no pricing)
    Page 2  Add-ons + order options + pricing → checkout
  Both pages live at the product URL; page 2 is ?step=2 (browser Back returns to page 1).

  Data (Shopify-native, nothing hardcoded):
    product.metafields.custom.flavors          bagel_flavor metaobjects (name, image, description, allergens, available)
    product.metafields.custom.addons           add-on products
    product.metafields.custom.sleeves_per_box  default 3
    product.metafields.custom.bagels_per_sleeve default 4
    variant price + selling plans              one-time price and Shopify Subscriptions plans
  Cart: 1 box line with properties "Sleeve 1".."Sleeve N" + hidden "_box_id"; add-on lines with the same
  "_box_id", subscribed on a plan with the same delivery frequency so they recur.
{%- endcomment -%}
{%- liquid
  # Box product: the section's product setting (landing pages) or the page's product (product template)
  assign bp = product
  if section.settings.product != blank
    assign bp = section.settings.product
  endif
  assign heading_tag = section.settings.heading_tag | default: 'h1'

  # Promo mode: one unit of promo_product added free as a one-time line; promo_code applied at checkout
  assign promo = section.settings.promo_product
  assign promo_v = promo.selected_or_first_available_variant
  assign promo_on = false
  if promo != blank and section.settings.promo_code != blank and promo_v.available
    assign promo_on = true
  endif

  # Lead step (delivery check) between page 1 and page 2; skipped for signed-in customers
  assign lead_on = section.settings.lead_enabled
  if customer
    assign lead_on = false
  endif

  # Presentation blocks (New York Bagel Express design)
  assign b_banner = nil
  assign b_fhead = nil
  assign b_copy = nil
  assign b_ship = nil
  for blk in section.blocks
    case blk.type
      when 'banner'
        assign b_banner = blk
      when 'flavors_head'
        assign b_fhead = blk
      when 'shipping'
        assign b_ship = blk
      when 'copy'
        assign b_copy = blk
    endcase
  endfor

  assign variant = bp.selected_or_first_available_variant
  assign sleeves = bp.metafields.custom.sleeves_per_box.value | default: 3
  assign per_sleeve = bp.metafields.custom.bagels_per_sleeve.value | default: 4
  assign total_bagels = sleeves | times: per_sleeve
  assign flavors = bp.metafields.custom.flavors.value
  assign addons = bp.metafields.custom.addons.value

  assign best_alloc = nil
  for alloc in variant.selling_plan_allocations
    if best_alloc == nil or alloc.price < best_alloc.price
      assign best_alloc = alloc
    endif
  endfor
  assign has_plans = false
  if variant.selling_plan_allocations.size > 0
    assign has_plans = true
  endif
  if best_alloc and variant.price > best_alloc.price
    assign save_pct = variant.price | minus: best_alloc.price | times: 100.0 | divided_by: variant.price | round
    assign save_amount = variant.price | minus: best_alloc.price
  endif
  assign default_option = section.settings.default_option
  if has_plans == false
    assign default_option = 'once'
  endif
-%}

{%- comment -%} Styles load before the markup so the page never paints unstyled (all step headings visible) {%- endcomment -%}
{{ 'bbb-box-builder.css' | asset_url | stylesheet_tag }}
{{ 'nybe-builder.css' | asset_url | stylesheet_tag }}
<section
  id="{{ section.settings.anchor | default: 'build' | handleize }}"
  class="bbb-builder{% if promo_on %} bbb-builder--promo{% endif %}{% if section.settings.product != blank %} bbb-builder--embedded{% endif %} color-{{ section.settings.color_scheme | default: 'scheme-2' }} gradient"
  data-bbb-builder
  data-step="1"
  aria-labelledby="bbb-builder-title-{{ section.id }}"
>
  {%- if b_banner -%}
    {%- comment -%} Photo banner; its copy follows the current step via [data-step] (CSS only) {%- endcomment -%}
    <div class="nybe-banner color-scheme-5" {{ b_banner.shopify_attributes }}>
      <div class="nybe-banner__bg" aria-hidden="true">
        {%- if b_banner.settings.image != blank -%}
          {{ b_banner.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '900, 1400, 2000', sizes: '100vw', alt: '', class: 'nybe-banner__img' }}
        {%- else -%}
          <picture>
            <source type="image/webp" srcset="{{ 'nybe-banner-900.webp' | asset_url }} 900w, {{ 'nybe-banner-1400.webp' | asset_url }} 1400w, {{ 'nybe-banner-2083.webp' | asset_url }} 2083w" sizes="100vw">
            <img src="{{ 'nybe-banner-1400.jpg' | asset_url }}" width="2083" height="423" alt="" class="nybe-banner__img" loading="eager" fetchpriority="high">
          </picture>
        {%- endif -%}
      </div>
      <div class="page-width nybe-banner__inner">
        <div class="nybe-banner__copy nybe-banner__copy--p1">
          {%- if section.settings.eyebrow != blank -%}<p class="bbb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <{{ heading_tag }} id="bbb-builder-title-{{ section.id }}" class="bbb-display nybe-banner__title" tabindex="-1" data-bbb-focus="1">{{ section.settings.heading | default: bp.title | replace: '[sleeves]', sleeves | escape }}</{{ heading_tag }}>
          <p class="nybe-banner__sub">{{- section.settings.subheading | replace: '[sleeves]', sleeves | replace: '[per_sleeve]', per_sleeve | replace: '[total]', total_bagels | escape | replace: '. ', '.<br>' -}}</p>
        </div>
        <div class="nybe-banner__copy nybe-banner__copy--p2">
          {%- if section.settings.eyebrow != blank -%}<p class="bbb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="bbb-display nybe-banner__title" tabindex="-1" data-bbb-focus="2">{{ section.settings.page2_heading | escape }}</h2>
          {%- if b_copy and b_copy.settings.page2_text != blank -%}<p class="nybe-banner__sub">{{ b_copy.settings.page2_text | escape }}</p>{%- endif -%}
        </div>
        {%- if lead_on -%}
          <div class="nybe-banner__copy nybe-banner__copy--lead">
            {%- if section.settings.eyebrow != blank -%}<p class="bbb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
            {%- comment -%} Keep the last two words together ("ZIP code") so they never split across lines {%- endcomment -%}
            {%- assign lead_words = section.settings.lead_heading | escape | split: ' ' -%}
            <h2 class="bbb-display nybe-banner__title" tabindex="-1" data-bbb-focus="lead">
              {%- for w in lead_words -%}{{ w }}{% unless forloop.last %}{% if forloop.rindex == 2 %}&nbsp;{% else %} {% endif %}{% endunless %}{%- endfor -%}
            </h2>
            {%- if section.settings.lead_text != blank -%}<p class="nybe-banner__sub">{{ section.settings.lead_text | escape }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="page-width bbb-builder__wrap">
    {%- capture stepnav -%}
    <nav class="bbb-stepnav STEPNAV_CLASS" aria-label="Order steps">
      <ol class="bbb-stepnav__list" role="list">
        <li class="bbb-stepnav__item" data-bbb-stepnav="1" aria-current="step"><span class="bbb-stepnav__dot" aria-hidden="true"><span class="nybe-stepnav__n">1</span>{% render 'bbb-icon', name: 'check', size: 14, stroke: 3, class: 'nybe-stepnav__check' %}</span> <span class="bbb-stepnav__label">{{ section.settings.nav1 | escape }}</span></li>
        {%- assign nav_n = 2 -%}
        {%- if lead_on -%}
          <li class="bbb-stepnav__item" data-bbb-stepnav="lead" data-bbb-nav-lead><span class="bbb-stepnav__dot" aria-hidden="true"><span class="nybe-stepnav__n">2</span>{% render 'bbb-icon', name: 'check', size: 14, stroke: 3, class: 'nybe-stepnav__check' %}</span> <span class="bbb-stepnav__label">Delivery Check</span></li>
          {%- assign nav_n = 3 -%}
        {%- endif -%}
        <li class="bbb-stepnav__item" data-bbb-stepnav="2"><span class="bbb-stepnav__dot" aria-hidden="true"><span class="nybe-stepnav__n">{{ nav_n }}</span>{% render 'bbb-icon', name: 'check', size: 14, stroke: 3, class: 'nybe-stepnav__check' %}</span> <span class="bbb-stepnav__label">{{ section.settings.nav2 | escape }}</span></li>
        <li class="bbb-stepnav__item"><span class="bbb-stepnav__dot" aria-hidden="true">{{ nav_n | plus: 1 }}</span> <span class="bbb-stepnav__label">Checkout</span></li>
      </ol>
    </nav>
    {%- endcapture -%}
    {{ stepnav | replace: 'STEPNAV_CLASS', 'nybe-stepnav--top' }}

    {%- if flavors == blank -%}
      <p class="bbb-editor-note">Add flavors to this product's “Box flavors” field in Shopify admin to use the builder.</p>
    {%- else -%}
    <noscript><p class="bbb-editor-note">The box builder needs JavaScript. Please enable it, or contact us to order.</p></noscript>

    {%- comment -%} ================= PAGE 1 — PICK SLEEVES (no pricing) ================= {%- endcomment -%}
    <div class="bbb-view" data-bbb-view="1">
      {%- unless b_banner -%}
      <header class="bbb-builder__head">
        {%- if section.settings.eyebrow != blank -%}<p class="bbb-eyebrow nybe-rule">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <{{ heading_tag }} id="bbb-builder-title-{{ section.id }}" class="bbb-display bbb-display--l" tabindex="-1" data-bbb-focus="1">{{ section.settings.heading | default: bp.title | replace: '[sleeves]', sleeves | escape }}</{{ heading_tag }}>
        <p class="bbb-builder__sub">
          {{- section.settings.subheading | replace: '[sleeves]', sleeves | replace: '[per_sleeve]', per_sleeve | replace: '[total]', total_bagels | escape | replace: '. ', '.<br>' -}}
        </p>
      </header>
      {%- endunless -%}
      {%- if promo_on -%}
        <div class="bbb-promo bbb-promo--banner">
          <span class="bbb-promo__media" aria-hidden="true">
            {%- if promo.featured_image != blank -%}{{ promo.featured_image | image_url: height: 320 | image_tag: loading: 'lazy', alt: '', class: 'bbb-promo__img' }}<svg class="nybe-promo__spark" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" focusable="false"><g class="nybe-promo__spark-g"><path d="M29 25 27.5 8"/><path d="M23.5 29.5 11 17"/><path d="M21 35.5 5 34"/></g></svg>{%- endif -%}
          </span>
          {%- liquid
            # "Mini Bagels (6)" reads as "6x Mini Bagels"
            assign promo_name = promo.title
            if promo.title contains ' ('
              assign pr_parts = promo.title | split: ' ('
              assign pr_qty = pr_parts.last | remove: ')' | strip
              assign promo_name = pr_qty | append: 'x ' | append: pr_parts.first
            endif
          -%}
          <p class="bbb-promo__text">
            <span class="bbb-promo__line1"><span class="bbb-promo__tag">Free</span> <strong>{{ promo_name | escape }}</strong></span>
            <span class="bbb-promo__line2">On us with this box. Fresh-baked and packed right in.</span>
            {%- if promo.price > 0 -%}<span class="bbb-promo__reg">{% render 'bbb-icon', name: 'gift', size: 18, stroke: 2, class: 'bbb-promo__reg-icon' %}<span class="bbb-promo__reg-amt">{{ promo.price | money }}</span><span class="bbb-promo__reg-note">value</span></span>{%- endif -%}
          </p>
        </div>
        {%- comment -%} On free-item pages the step progress sits under this banner on page 1 (the top copy is hidden there) {%- endcomment -%}
        {{ stepnav | replace: 'STEPNAV_CLASS', 'nybe-stepnav--inline' }}
      {%- endif -%}

      <span class="nybe-tray-sentinel" data-nybe-tray-sentinel aria-hidden="true"></span>
      <div class="bbb-tray" aria-label="Your sleeves" data-nybe-tray>
        {%- liquid
          # Free-item page: the free minis show as a 4th (already filled) tile next to the sleeves
          assign tray_free = false
          if promo_on and promo.featured_image != blank
            assign tray_free = true
          endif
          assign tray_cols = sleeves
          if tray_free
            assign tray_cols = sleeves | plus: 1
          endif
        -%}
        <ol class="bbb-tray__slots{% if tray_free %} nybe-tray__slots--free{% endif %}" role="list" data-bbb-slots style="--bbb-sleeves: {{ tray_cols }};">
          {%- for i in (1..sleeves) -%}
            <li>
              <button type="button" class="bbb-slot" data-bbb-slot="{{ forloop.index0 }}" aria-label="Sleeve {{ i }}: empty. Choose a flavor">
                <span class="bbb-slot__img" aria-hidden="true"></span>
                <span class="nybe-slot__plus" aria-hidden="true">{% render 'bbb-icon', name: 'plus', size: 26, stroke: 1.75 %}</span>
                <span class="nybe-slot__x" aria-hidden="true">{% render 'bbb-icon', name: 'x', size: 14, stroke: 3 %}</span>
                <span class="bbb-slot__label"><span class="bbb-slot__n">Sleeve {{ i }}</span> <span data-bbb-slot-label>Add flavor</span></span>
              </button>
            </li>
          {%- endfor -%}
          {%- if tray_free -%}
            <li>
              <div class="bbb-slot is-filled nybe-slot--free" role="img" aria-label="Free with this box: {{ promo_name | escape }}">
                <span class="bbb-slot__img" aria-hidden="true">{{ promo.featured_image | image_url: height: 240 | image_tag: loading: 'lazy', alt: '' }}</span>
                {%- liquid
                  # Short tile label: "6x Minis" (full name stays in the aria-label)
                  assign tile_name = promo_name
                  if pr_qty != blank
                    assign tile_name = pr_qty | append: 'x Minis'
                  endif
                -%}
                <span class="bbb-slot__label" aria-hidden="true"><span class="bbb-slot__n">Free</span> <span>{{ tile_name | escape }}</span></span>
              </div>
            </li>
          {%- endif -%}
        </ol>
        <div class="bbb-tray__status">
          <p class="bbb-progress" data-bbb-progress aria-live="polite">0 of {{ sleeves }} sleeves selected</p>
          <p class="bbb-tray__hint">{{ section.settings.tray_hint | replace: '[per_sleeve]', per_sleeve | replace: '[sleeves]', sleeves | replace: '[total]', total_bagels | escape }}</p>
        </div>
        <button type="button" class="button button--primary bbb-next nybe-tray__next" data-bbb-next aria-disabled="true"><span>{{ section.settings.next_short_label | default: 'Next' | escape }}</span>{% render 'bbb-icon', name: 'arrow-right', size: 18, class: 'nybe-btn-arrow' %}</button>
        {%- if b_banner and addons.first.featured_image != blank -%}
          <span class="nybe-tray__art" aria-hidden="true">{{ addons.first.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}</span>
        {%- endif -%}
      </div>

      {%- if b_fhead -%}
        <header class="bbb-section__header nybe-fhead" {{ b_fhead.shopify_attributes }}>
          {%- if b_fhead.settings.eyebrow != blank -%}<p class="bbb-eyebrow nybe-rule">{{ b_fhead.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="bbb-display bbb-display--l">{{ b_fhead.settings.heading | escape }}</h2>
          {%- if b_fhead.settings.text != blank -%}<p>{{ b_fhead.settings.text | escape }}</p>{%- endif -%}
        </header>
      {%- endif -%}

      <ul class="bbb-fgrid" role="list">
        {%- for f in flavors -%}
          {%- liquid
            assign f_available = true
            if f.available.value == false
              assign f_available = false
            endif
            assign f_img = f.image.value
          -%}
          <li
            class="bbb-fcard{% unless f_available %} is-unavailable{% endunless %}"
            data-bbb-flavor="{{ f.system.handle | escape }}"
            data-name="{{ f.name.value | escape }}"
            {% if f_img != blank %}data-img="{{ f_img | image_url: width: 160 }}"{% endif %}
            {% unless f_available %}data-unavailable{% endunless %}
          >
            <div class="bbb-fcard__media">
              {%- if f_img != blank -%}
                {{ f_img | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: '(min-width: 990px) 220px, (min-width: 750px) 30vw, 46vw', alt: f.name.value, class: 'bbb-fcard__img' }}
              {%- else -%}
                <span class="bbb-fcard__noimg" aria-hidden="true"></span>
              {%- endif -%}
              <span class="bbb-fcard__badge" data-bbb-badge hidden></span>
              <span class="nybe-fcard__check" aria-hidden="true">{% render 'bbb-icon', name: 'check', size: 16, stroke: 3 %}</span>
            </div>
            <div class="bbb-fcard__body">
              <h2 class="bbb-fcard__name" id="bbb-fl-{{ section.id }}-{{ f.system.handle }}"><span><span class="nybe-qty">{{ per_sleeve }}x</span> {{ f.name.value | escape }}</span></h2>
              {%- if f.description.value != blank -%}<p class="bbb-fcard__desc">{{ f.description.value | escape }}</p>{%- endif -%}
              {%- if f.allergens.value != blank -%}<p class="bbb-fcard__allergen">{{ f.allergens.value | escape }}</p>{%- endif -%}
              {%- unless f_available -%}<p class="bbb-fcard__desc">Unavailable right now</p>{%- endunless -%}
              <div class="bbb-stepper" role="group" aria-labelledby="bbb-fl-{{ section.id }}-{{ f.system.handle }}">
                <button type="button" class="bbb-stepper__btn" data-bbb-dec aria-label="Remove one sleeve of {{ f.name.value | escape }}" disabled>
                  <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                </button>
                <output class="bbb-stepper__count" data-bbb-count aria-label="{{ f.name.value | escape }} sleeves">0</output>
                <button type="button" class="bbb-stepper__btn bbb-stepper__btn--add" data-bbb-inc aria-label="Add one sleeve of {{ f.name.value | escape }}"{% unless f_available %} disabled{% endunless %}>
                  <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h10M8 3v10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                </button>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <p class="bbb-builder__error" data-bbb-error="1" role="alert" hidden></p>
      <div class="bbb-view__actions">
        <button type="button" class="button button--primary bbb-next" data-bbb-next><span>{{ section.settings.next_label | escape }}</span>{% render 'bbb-icon', name: 'arrow-right', size: 20, class: 'nybe-btn-arrow' %}</button>
      </div>
      {%- assign p1b = section.blocks | where: 'type', 'p1_benefit' -%}
      {%- if p1b.size > 0 -%}
        <ul class="nybe-benefit-row" role="list">
          {%- for blk in p1b -%}
            <li class="nybe-benefit-row__item" {{ blk.shopify_attributes }}>
              <span class="nybe-benefit-row__icon" aria-hidden="true">{%- render 'bbb-icon', name: blk.settings.icon, size: 26, stroke: 1.75 -%}</span>
              <span><strong>{{ blk.settings.title | escape }}</strong>{% if blk.settings.text != blank %}<span>{{ blk.settings.text | escape }}</span>{% endif %}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%}
      ================= LEAD STEP — delivery check =================
      Posts to Shopify's customer form (no app): creates/updates a customer subscribed to email marketing,
      tagged lead, lead-<source>, zip-<ZIP>, sms-optin (if ticked) and out-of-area (if we can't ship there).
      Name and ZIP inputs have no name attribute; JS maps them into first/last name and tags.
    {%- endcomment -%}
    {%- if lead_on -%}
      <div class="bbb-view" data-bbb-view="lead" hidden>
        <header class="bbb-builder__head bbb-builder__head--left nybe-leadhead">
          <button type="button" class="bbb-back link" data-bbb-back>
            <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {{ section.settings.back_label | escape }}
          </button>
          {%- unless b_banner -%}
            {%- assign lead_words2 = section.settings.lead_heading | escape | split: ' ' -%}
            <h2 class="bbb-display bbb-display--l" tabindex="-1" data-bbb-focus="lead">{%- for w in lead_words2 -%}{{ w }}{% unless forloop.last %}{% if forloop.rindex == 2 %}&nbsp;{% else %} {% endif %}{% endunless %}{%- endfor -%}</h2>
            {%- if section.settings.lead_text != blank -%}<p class="bbb-builder__sub">{{ section.settings.lead_text | escape }}</p>{%- endif -%}
          {%- endunless -%}
        </header>

        <div class="bbb-card2 bbb-lead">
          <div class="nybe-lead__head">
            <span class="nybe-lead__icon" aria-hidden="true">{% render 'bbb-icon', name: 'map-pin', size: 26, stroke: 2 %}</span>
            <div>
              <p class="nybe-lead__title">Where should we send your bagels?</p>
              <p class="nybe-lead__sub">We ship to the lower 48 states and Washington, DC.</p>
            </div>
          </div>
          {%- form 'customer', id: 'BbbLeadForm', class: 'bbb-form bbb-lead__form', novalidate: 'novalidate' -%}
            <input type="hidden" name="contact[tags]" value="lead" data-bbb-lead-tags>
            <input type="hidden" name="contact[first_name]" data-bbb-lead-first>
            <input type="hidden" name="contact[last_name]" data-bbb-lead-last>
            <input type="hidden" name="contact[phone]" data-bbb-lead-phone-field disabled>
            <input type="hidden" name="return_to" data-bbb-lead-return>
            <div class="bbb-form__2col">
              <div class="bbb-form__row nybe-lead__zip">
                <label class="bbb-form__label" for="BbbLead-zip">ZIP code <span aria-hidden="true">*</span></label>
                <input class="bbb-form__input" id="BbbLead-zip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="5" pattern="[0-9]{5}" required aria-required="true" data-bbb-lead-zip>
              </div>
              <div class="bbb-form__row">
                <label class="bbb-form__label" for="BbbLead-name">Name <span aria-hidden="true">*</span></label>
                <input class="bbb-form__input" id="BbbLead-name" type="text" autocomplete="name" required aria-required="true" data-bbb-lead-name>
              </div>
              <div class="bbb-form__row">
                <label class="bbb-form__label" for="BbbLead-email">Email <span aria-hidden="true">*</span></label>
                <input class="bbb-form__input" id="BbbLead-email" type="email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required aria-required="true" data-bbb-lead-email>
              </div>
              <div class="bbb-form__row">
                <label class="bbb-form__label" for="BbbLead-phone">Phone <span class="bbb-form__opt" data-bbb-lead-phone-opt>(optional)</span></label>
                <input class="bbb-form__input" id="BbbLead-phone" type="tel" autocomplete="tel" inputmode="tel" data-bbb-lead-phone>
              </div>
              {%- if section.settings.lead_sms_text != blank -%}
                <div class="bbb-form__row bbb-form__row--full">
                  <label class="bbb-lead__check">
                    <input type="checkbox" data-bbb-lead-sms>
                    <span>{{ section.settings.lead_sms_text | escape }}</span>
                  </label>
                </div>
              {%- endif -%}
            </div>
