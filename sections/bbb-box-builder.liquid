{%- comment -%}
  Bad Boy Bagel Co. — Build Your Box (ADR-002 Option C), two pages:
    Page 1  Pick your sleeves (flavor photo grid, no pricing)
    Page 2  Add-ons + order options + pricing → checkout
  Both pages live at the product URL; page 2 is ?step=2 (browser Back returns to page 1).

  Data (Shopify-native, nothing hardcoded):
    product.metafields.custom.flavors          bagel_flavor metaobjects (name, image, description, allergens, available)
    product.metafields.custom.addons           add-on products
    product.metafields.custom.sleeves_per_box  default 4
    product.metafields.custom.bagels_per_sleeve default 3
    variant price + selling plans              one-time price and Shopify Subscriptions plans
  Cart: 1 box line with properties "Sleeve 1".."Sleeve N" + hidden "_box_id"; add-on lines with the same
  "_box_id", subscribed on a plan with the same delivery frequency so they recur.
{%- endcomment -%}
{%- liquid
  # Box product: the section's product setting (landing pages) or the page's product (product template)
  assign bp = product
  if section.settings.product != blank
    assign bp = section.settings.product
  endif
  assign heading_tag = section.settings.heading_tag | default: 'h1'

  # Promo mode: one unit of promo_product added free as a one-time line; promo_code applied at checkout
  assign promo = section.settings.promo_product
  assign promo_v = promo.selected_or_first_available_variant
  assign promo_on = false
  if promo != blank and section.settings.promo_code != blank and promo_v.available
    assign promo_on = true
  endif

  # Lead step (delivery check) between page 1 and page 2; skipped for signed-in customers
  assign lead_on = section.settings.lead_enabled
  if customer
    assign lead_on = false
  endif

  assign variant = bp.selected_or_first_available_variant
  assign sleeves = bp.metafields.custom.sleeves_per_box.value | default: 4
  assign per_sleeve = bp.metafields.custom.bagels_per_sleeve.value | default: 3
  assign total_bagels = sleeves | times: per_sleeve
  assign flavors = bp.metafields.custom.flavors.value
  assign addons = bp.metafields.custom.addons.value

  assign best_alloc = nil
  for alloc in variant.selling_plan_allocations
    if best_alloc == nil or alloc.price < best_alloc.price
      assign best_alloc = alloc
    endif
  endfor
  assign has_plans = false
  if variant.selling_plan_allocations.size > 0
    assign has_plans = true
  endif
  if best_alloc and variant.price > best_alloc.price
    assign save_pct = variant.price | minus: best_alloc.price | times: 100.0 | divided_by: variant.price | round
    assign save_amount = variant.price | minus: best_alloc.price
  endif
  assign default_option = section.settings.default_option
  if has_plans == false
    assign default_option = 'once'
  endif
-%}

<section
  id="{{ section.settings.anchor | default: 'build' | handleize }}"
  class="bbb-builder{% if promo_on %} bbb-builder--promo{% endif %}{% if section.settings.product != blank %} bbb-builder--embedded{% endif %} color-{{ section.settings.color_scheme | default: 'scheme-2' }} gradient"
  data-bbb-builder
  data-step="1"
  aria-labelledby="bbb-builder-title-{{ section.id }}"
>
  <div class="page-width bbb-builder__wrap">
    <nav class="bbb-stepnav" aria-label="Order steps">
      <ol class="bbb-stepnav__list" role="list">
        <li class="bbb-stepnav__item" data-bbb-stepnav="1" aria-current="step"><span class="bbb-stepnav__dot" aria-hidden="true">1</span> <span class="bbb-stepnav__label">{{ section.settings.nav1 | escape }}</span></li>
        {%- assign nav_n = 2 -%}
        {%- if lead_on -%}
          <li class="bbb-stepnav__item" data-bbb-stepnav="lead" data-bbb-nav-lead><span class="bbb-stepnav__dot" aria-hidden="true">2</span> <span class="bbb-stepnav__label">Delivery check</span></li>
          {%- assign nav_n = 3 -%}
        {%- endif -%}
        <li class="bbb-stepnav__item" data-bbb-stepnav="2"><span class="bbb-stepnav__dot" aria-hidden="true">{{ nav_n }}</span> <span class="bbb-stepnav__label">{{ section.settings.nav2 | escape }}</span></li>
        <li class="bbb-stepnav__item"><span class="bbb-stepnav__dot" aria-hidden="true">{{ nav_n | plus: 1 }}</span> <span class="bbb-stepnav__label">Checkout</span></li>
      </ol>
    </nav>

    {%- if flavors == blank -%}
      <p class="bbb-editor-note">Add flavors to this product's “Box flavors” field in Shopify admin to use the builder.</p>
    {%- else -%}
    <noscript><p class="bbb-editor-note">The box builder needs JavaScript. Please enable it, or contact us to order.</p></noscript>

    {%- comment -%} ================= PAGE 1 — PICK SLEEVES (no pricing) ================= {%- endcomment -%}
    <div class="bbb-view" data-bbb-view="1">
      <header class="bbb-builder__head">
        {%- if section.settings.eyebrow != blank -%}<p class="bbb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <{{ heading_tag }} id="bbb-builder-title-{{ section.id }}" class="bbb-display bbb-display--l" tabindex="-1" data-bbb-focus="1">{{ section.settings.heading | default: bp.title | escape }}</{{ heading_tag }}>
        <p class="bbb-builder__sub">
          {{- section.settings.subheading | replace: '[sleeves]', sleeves | replace: '[per_sleeve]', per_sleeve | replace: '[total]', total_bagels | escape -}}
        </p>
      </header>
      {%- if promo_on -%}
        <div class="bbb-promo bbb-promo--banner">
          <span class="bbb-promo__media" aria-hidden="true">
            {%- if promo.featured_image != blank -%}{{ promo.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', class: 'bbb-promo__img' }}{%- endif -%}
          </span>
          <p class="bbb-promo__text"><span class="bbb-promo__tag">Free</span> <strong>{{ promo.title | escape }}</strong> comes free with this box.</p>
        </div>
      {%- endif -%}

      <div class="bbb-tray" aria-label="Your sleeves">
        <ol class="bbb-tray__slots" role="list" data-bbb-slots>
          {%- for i in (1..sleeves) -%}
            <li>
              <button type="button" class="bbb-slot" data-bbb-slot="{{ forloop.index0 }}" disabled>
                <span class="bbb-slot__img" aria-hidden="true"></span>
                <span class="bbb-slot__label"><span class="bbb-slot__n">Sleeve {{ i }}</span> <span data-bbb-slot-label>Empty</span></span>
              </button>
            </li>
          {%- endfor -%}
        </ol>
        <div class="bbb-tray__status">
          <p class="bbb-progress" data-bbb-progress aria-live="polite">0 of {{ sleeves }} sleeves selected</p>
          <p class="bbb-tray__hint">{{ section.settings.tray_hint | replace: '[per_sleeve]', per_sleeve | escape }}</p>
        </div>
      </div>

      <ul class="bbb-fgrid" role="list">
        {%- for f in flavors -%}
          {%- liquid
            assign f_available = true
            if f.available.value == false
              assign f_available = false
            endif
            assign f_img = f.image.value
          -%}
          <li
            class="bbb-fcard{% unless f_available %} is-unavailable{% endunless %}"
            data-bbb-flavor="{{ f.system.handle | escape }}"
            data-name="{{ f.name.value | escape }}"
            {% if f_img != blank %}data-img="{{ f_img | image_url: width: 160 }}"{% endif %}
            {% unless f_available %}data-unavailable{% endunless %}
          >
            <div class="bbb-fcard__media">
              {%- if f_img != blank -%}
                {{ f_img | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: '(min-width: 990px) 220px, (min-width: 750px) 30vw, 46vw', alt: f.name.value, class: 'bbb-fcard__img' }}
              {%- else -%}
                <span class="bbb-fcard__noimg" aria-hidden="true"></span>
              {%- endif -%}
              <span class="bbb-fcard__badge" data-bbb-badge hidden></span>
            </div>
            <div class="bbb-fcard__body">
              <h2 class="bbb-fcard__name" id="bbb-fl-{{ section.id }}-{{ f.system.handle }}">{{ f.name.value | escape }}</h2>
              {%- if f.description.value != blank -%}<p class="bbb-fcard__desc">{{ f.description.value | escape }}</p>{%- endif -%}
              {%- if f.allergens.value != blank -%}<p class="bbb-fcard__allergen">{{ f.allergens.value | escape }}</p>{%- endif -%}
              {%- unless f_available -%}<p class="bbb-fcard__desc">Unavailable right now</p>{%- endunless -%}
              <div class="bbb-stepper" role="group" aria-labelledby="bbb-fl-{{ section.id }}-{{ f.system.handle }}">
                <button type="button" class="bbb-stepper__btn" data-bbb-dec aria-label="Remove one sleeve of {{ f.name.value | escape }}" disabled>
                  <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                </button>
                <output class="bbb-stepper__count" data-bbb-count aria-label="{{ f.name.value | escape }} sleeves">0</output>
                <button type="button" class="bbb-stepper__btn bbb-stepper__btn--add" data-bbb-inc aria-label="Add one sleeve of {{ f.name.value | escape }}"{% unless f_available %} disabled{% endunless %}>
                  <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h10M8 3v10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                </button>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <p class="bbb-builder__error" data-bbb-error="1" role="alert" hidden></p>
      <div class="bbb-view__actions">
        <button type="button" class="button button--primary bbb-next" data-bbb-next>{{ section.settings.next_label | escape }}</button>
      </div>
    </div>

    {%- comment -%}
      ================= LEAD STEP — delivery check =================
      Posts to Shopify's customer form (no app): creates/updates a customer subscribed to email marketing,
      tagged lead, lead-<source>, zip-<ZIP>, sms-optin (if ticked) and out-of-area (if we can't ship there).
      Name and ZIP inputs have no name attribute; JS maps them into first/last name and tags.
    {%- endcomment -%}
    {%- if lead_on -%}
      <div class="bbb-view" data-bbb-view="lead" hidden>
        <header class="bbb-builder__head bbb-builder__head--left">
          <button type="button" class="bbb-back link" data-bbb-back>
            <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {{ section.settings.back_label | escape }}
          </button>
          <h2 class="bbb-display bbb-display--l" tabindex="-1" data-bbb-focus="lead">{{ section.settings.lead_heading | escape }}</h2>
          {%- if section.settings.lead_text != blank -%}<p class="bbb-builder__sub">{{ section.settings.lead_text | escape }}</p>{%- endif -%}
        </header>

        <div class="bbb-card2 bbb-lead">
          {%- form 'customer', id: 'BbbLeadForm', class: 'bbb-form bbb-lead__form', novalidate: 'novalidate' -%}
            <input type="hidden" name="contact[tags]" value="lead" data-bbb-lead-tags>
            <input type="hidden" name="contact[first_name]" data-bbb-lead-first>
            <input type="hidden" name="contact[last_name]" data-bbb-lead-last>
            <div class="bbb-form__2col">
              <div class="bbb-form__row">
                <label class="bbb-form__label" for="BbbLead-name">Name <span aria-hidden="true">*</span></label>
                <input class="bbb-form__input" id="BbbLead-name" type="text" autocomplete="name" required aria-required="true" data-bbb-lead-name>
              </div>
              <div class="bbb-form__row">
                <label class="bbb-form__label" for="BbbLead-zip">ZIP code <span aria-hidden="true">*</span></label>
                <input class="bbb-form__input" id="BbbLead-zip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" required aria-required="true" data-bbb-lead-zip>
              </div>
              <div class="bbb-form__row">
                <label class="bbb-form__label" for="BbbLead-email">Email <span aria-hidden="true">*</span></label>
                <input class="bbb-form__input" id="BbbLead-email" type="email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required aria-required="true" data-bbb-lead-email>
              </div>
              <div class="bbb-form__row">
                <label class="bbb-form__label" for="BbbLead-phone">Phone <span class="bbb-form__opt">(optional)</span></label>
                <input class="bbb-form__input" id="BbbLead-phone" type="tel" autocomplete="tel" inputmode="tel" data-bbb-lead-phone>
              </div>
              {%- if section.settings.lead_sms_text != blank -%}
                <div class="bbb-form__row bbb-form__row--full">
                  <label class="bbb-lead__check">
                    <input type="checkbox" data-bbb-lead-sms>
                    <span>{{ section.settings.lead_sms_text | escape }}</span>
                  </label>
                </div>
              {%- endif -%}
            </div>
            <p class="bbb-builder__error" data-bbb-error="lead" role="alert" hidden></p>
            <button type="submit" class="button button--primary bbb-form__submit bbb-lead__submit" data-bbb-lead-submit>{{ section.settings.lead_button | escape }}</button>
            {%- if section.settings.lead_disclosure != blank -%}<div class="bbb-lead__disclosure">{{ section.settings.lead_disclosure }}</div>{%- endif -%}
          {%- endform -%}

          <div class="bbb-lead__ok" data-bbb-lead-ok hidden tabindex="-1">
            <span class="bbb-lead__tick" aria-hidden="true">
              <svg viewBox="0 0 48 48" width="48" height="48" focusable="false"><circle cx="24" cy="24" r="22" fill="currentColor"/><path d="m14 25 7 7 13-15" fill="none" stroke="#fff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <p class="bbb-lead__ok-title" role="status" data-bbb-lead-ok-text></p>
            <button type="button" class="button button--primary" data-bbb-lead-continue>Continue</button>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ================= PAGE 2 — ADD-ONS, OPTIONS, PRICING ================= {%- endcomment -%}
    <div class="bbb-view" data-bbb-view="2" hidden>
      <header class="bbb-builder__head bbb-builder__head--left">
        <button type="button" class="bbb-back link" data-bbb-back>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 16 16" width="14" height="14"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ section.settings.back_label | escape }}
        </button>
        <h2 class="bbb-display bbb-display--l" tabindex="-1" data-bbb-focus="2">{{ section.settings.page2_heading | escape }}</h2>
      </header>

      <div class="bbb-p2">
        <div class="bbb-p2__main">
          <section class="bbb-card2" aria-labelledby="bbb-yourbox-{{ section.id }}">
            <div class="bbb-card2__head">
              <h3 class="bbb-card2__title" id="bbb-yourbox-{{ section.id }}">{{ section.settings.yourbox_title | escape }}</h3>
              <button type="button" class="link bbb-card2__edit" data-bbb-back>Edit</button>
            </div>
            <ul class="bbb-boxsum" role="list" data-bbb-boxsum></ul>
          </section>

          {%- if promo_on -%}
            <section class="bbb-card2 bbb-promo bbb-promo--card" aria-labelledby="bbb-promo-{{ section.id }}">
              <span class="bbb-promo__media" aria-hidden="true">
                {%- if promo.featured_image != blank -%}{{ promo.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', class: 'bbb-promo__img' }}{%- endif -%}
              </span>
              <div class="bbb-promo__body">
                <p class="bbb-promo__tag">Free with your dozen</p>
                <h3 class="bbb-card2__title" id="bbb-promo-{{ section.id }}">{{ promo.title | escape }}</h3>
                {%- if section.settings.promo_note != blank -%}<p class="bbb-promo__note">{{ section.settings.promo_note | escape }}</p>{%- endif -%}
              </div>
              <p class="bbb-promo__price"><s>{{ promo_v.price | money }}</s> <strong>Free</strong></p>
            </section>
          {%- endif -%}

          {%- if addons != blank -%}
            <section class="bbb-card2" aria-labelledby="bbb-addons-{{ section.id }}">
              <div class="bbb-card2__head">
                <h3 class="bbb-card2__title" id="bbb-addons-{{ section.id }}">{{ section.settings.step2_title | escape }}</h3>
                {%- if section.settings.step2_hint != blank -%}<p class="bbb-card2__hint">{{ section.settings.step2_hint | escape }}</p>{%- endif -%}
              </div>
              <ul class="bbb-addons" role="list">
                {%- for a in addons -%}
                  {%- if promo_on and a.id == promo.id -%}{%- continue -%}{%- endif -%}
                  {%- assign av = a.selected_or_first_available_variant -%}
                  {%- if av -%}
                    <li>
                      <label class="bbb-addon">
                        <input type="checkbox" class="bbb-addon__input" data-bbb-addon="{{ av.id }}" value="{{ av.id }}"{% unless av.available %} disabled{% endunless %}>
                        <span class="bbb-addon__media" aria-hidden="true">
                          {%- if a.featured_image != blank -%}
                            {{ a.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', class: 'bbb-addon__img' }}
                          {%- else -%}
                            <span class="bbb-addon__noimg"></span>
                          {%- endif -%}
                        </span>
                        <span class="bbb-addon__text">
                          <span class="bbb-addon__name">{{ a.title | escape }}</span>
                          <span class="bbb-addon__price">+{{ av.price | money }}<span class="bbb-addon__every" data-bbb-every hidden> every box</span></span>
                        </span>
                        <span class="bbb-addon__check" aria-hidden="true"></span>
                      </label>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}

          <section class="bbb-card2" aria-labelledby="bbb-opts-{{ section.id }}">
            <div class="bbb-card2__head">
              <h3 class="bbb-card2__title" id="bbb-opts-{{ section.id }}">{{ section.settings.step3_title | escape }}</h3>
            </div>
            <fieldset class="bbb-options">
              <legend class="bbb-sr-only">Purchase option</legend>
              {%- if has_plans -%}
                <div class="bbb-option bbb-option--sub" data-bbb-sub-card>
                  <label class="bbb-option__row">
                    <input type="radio" name="bbb-purchase-{{ section.id }}" value="subscription" data-bbb-option{% if default_option == 'subscription' %} checked{% endif %}>
                    <span class="bbb-option__radio" aria-hidden="true"></span>
                    <span class="bbb-option__name">
                      {{ section.settings.sub_label | escape }}
                      {%- if save_pct and save_pct > 0 %} <span class="bbb-option__badge">Save {{ save_amount | money_without_trailing_zeros }}</span>{%- endif -%}
                    </span>
                    <span class="bbb-option__price"><span data-bbb-sub-price>{{ best_alloc.price | money }}</span>{%- if save_pct %}<s class="bbb-option__was">{{ variant.price | money }}</s>{%- endif -%}</span>
                  </label>
                  <div class="bbb-option__more">
                    {%- if variant.selling_plan_allocations.size > 1 -%}
                      <label class="bbb-option__freq-label" for="bbb-freq-{{ section.id }}">Choose frequency</label>
                      <select id="bbb-freq-{{ section.id }}" class="bbb-form__input" data-bbb-plan>
                        {%- for alloc in variant.selling_plan_allocations -%}
                          <option value="{{ alloc.selling_plan.id }}" data-price="{{ alloc.price }}"{% if alloc.selling_plan.id == best_alloc.selling_plan.id %} selected{% endif %}>{{ alloc.selling_plan.options | map: 'value' | join: ' / ' | default: alloc.selling_plan.name | escape }}</option>
                        {%- endfor -%}
                      </select>
                    {%- else -%}
                      <input type="hidden" value="{{ best_alloc.selling_plan.id }}" data-bbb-plan>
                      <p class="bbb-option__freq">{{ best_alloc.selling_plan.options | map: 'value' | join: ' / ' | default: best_alloc.selling_plan.name | escape }}</p>
                    {%- endif -%}
                    {%- if section.settings.sub_note != blank -%}<p class="bbb-option__note">{{ section.settings.sub_note | escape }}</p>{%- endif -%}
                  </div>
                </div>
              {%- elsif request.design_mode -%}
                <p class="bbb-editor-note">No subscription plan on this product yet. Create one in the Shopify Subscriptions app and the Subscribe and Save option appears here automatically.</p>
              {%- endif -%}

              <label class="bbb-option">
                <input type="radio" name="bbb-purchase-{{ section.id }}" value="once" data-bbb-option{% if default_option == 'once' %} checked{% endif %}>
                <span class="bbb-option__radio" aria-hidden="true"></span>
                <span class="bbb-option__name">{{ section.settings.once_label | escape }}</span>
                <span class="bbb-option__price">{{ variant.price | money }}</span>
              </label>
            </fieldset>
          </section>
        </div>

        <aside class="bbb-p2__side" aria-labelledby="bbb-summary-{{ section.id }}">
          <div class="bbb-card2 bbb-card2--sticky">
            <h3 class="bbb-card2__title" id="bbb-summary-{{ section.id }}">Order summary</h3>
            <dl class="bbb-totals" data-bbb-totals></dl>
            <p class="bbb-totals__total"><span>Total</span> <strong data-bbb-total>{{ variant.price | money }}</strong></p>
            {%- if section.settings.shipping_note != blank -%}<p class="bbb-totals__ship">{{ section.settings.shipping_note | escape }}</p>{%- endif -%}
            <p class="bbb-builder__error" data-bbb-error="2" role="alert" hidden></p>
            <button type="button" class="button button--primary bbb-checkout" data-bbb-add aria-describedby="bbb-disclosure-{{ section.id }}">
              <span data-bbb-add-label>{{ section.settings.add_label | escape }}</span>
            </button>
            <div class="bbb-totals__disclosure" id="bbb-disclosure-{{ section.id }}" data-bbb-disclosure hidden>
              {{ section.settings.disclosure | replace: '[price]', '<span data-bbb-disc-price></span>' | replace: '[frequency]', '<span data-bbb-disc-freq></span>' }}
            </div>
          </div>
        </aside>
      </div>
    </div>

    {%- comment -%} Mobile bottom bar — page 1: progress + Next (no price); page 2: total + Checkout {%- endcomment -%}
    <div class="bbb-bar" data-bbb-bar>
      <div class="bbb-bar__p1">
        <ol class="bbb-bar__dots" role="list" aria-hidden="true">
          {%- for i in (1..sleeves) -%}<li class="bbb-bar__dot" data-bbb-dot="{{ forloop.index0 }}"></li>{%- endfor -%}
        </ol>
        <span class="bbb-bar__count" data-bbb-bar-count>0 / {{ sleeves }}</span>
        <button type="button" class="button button--primary" data-bbb-next>{{ section.settings.bar_next_label | escape }}</button>
      </div>
      <div class="bbb-bar__p2">
        <span class="bbb-bar__total" data-bbb-bar-total>{{ variant.price | money }}</span>
        <button type="button" class="button button--primary" data-bbb-add>{{ section.settings.bar_label | escape }}</button>
      </div>
    </div>

    <script type="application/json" data-bbb-config>
      {
        "productId": {{ bp.id | json }},
        "variantId": {{ variant.id | json }},
        "title": {{ bp.title | json }},
        "sleeves": {{ sleeves | json }},
        "perSleeve": {{ per_sleeve | json }},
        "oncePrice": {{ variant.price | json }},
        "moneyFormat": {{ shop.money_format | json }},
        "cartAddUrl": {{ routes.cart_add_url | append: '.js' | json }},
        "cartUrl": {{ routes.cart_url | json }},
        "cartJsUrl": {{ routes.cart_url | append: '.js' | json }},
        "cartUpdateUrl": {{ routes.cart_update_url | append: '.js' | json }},
        "after": {{ section.settings.after_add | json }},
        "plans": [
          {%- for alloc in variant.selling_plan_allocations -%}
            { "id": {{ alloc.selling_plan.id | json }}, "name": {{ alloc.selling_plan.name | json }}, "key": {{ alloc.selling_plan.options | map: 'value' | join: ' / ' | json }}, "price": {{ alloc.price | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "promo": {%- if promo_on -%}{
          "variantId": {{ promo_v.id | json }},
          "title": {{ promo.title | json }},
          "price": {{ promo_v.price | json }},
          "code": {{ section.settings.promo_code | strip | json }}
        }{%- else -%}null{%- endif -%},
        "lead": {
          "enabled": {{ lead_on | json }},
          "source": {{ section.settings.lead_source | default: 'builder' | handleize | json }},
          "okText": "Good news — we deliver to [zip]!",
          "outText": "Sorry — we can't ship to [zip] yet. We ship to the lower 48 states and Washington, DC."
        },
        "addons": [
          {%- assign printed = false -%}
          {%- for a in addons -%}
            {%- if promo_on and a.id == promo.id -%}{%- continue -%}{%- endif -%}
            {%- assign av = a.selected_or_first_available_variant -%}
            {%- if printed -%},{%- endif -%}
            {%- assign printed = true -%}
            {
              "variantId": {{ av.id | json }},
              "title": {{ a.title | json }},
              "price": {{ av.price | json }},
              "plans": {
                {%- for alloc in av.selling_plan_allocations -%}
                  {{ alloc.selling_plan.id | append: '' | json }}: {{ alloc.price | json }}{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              },
              "planNames": {
                {%- for alloc in av.selling_plan_allocations -%}
                  {{ alloc.selling_plan.id | append: '' | json }}: {{ alloc.selling_plan.name | json }}{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              },
              "planKeys": {
                {%- for alloc in av.selling_plan_allocations -%}
                  {{ alloc.selling_plan.id | append: '' | json }}: {{ alloc.selling_plan.options | map: 'value' | join: ' / ' | json }}{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              }
            }
          {%- endfor -%}
        ],
        "labels": {
          "progress": {{ section.settings.progress_label | json }},
          "needMore": {{ section.settings.error_need_more | json }},
          "chooseOption": {{ section.settings.error_choose_option | json }},
          "adding": "Adding…",
          "failed": "Sorry, something went wrong adding your box. Please try again."
        }
      }
    </script>
    {%- endif -%}
  </div>
</section>

{{ 'bbb-box-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bbb-box-builder.js' | asset_url }}" defer="defer"></script>

{%- if template.name == 'product' and section.settings.product == blank -%}
<script type="application/ld+json">
  {{ bp | structured_data }}
</script>
{%- endif -%}

{% schema %}
{
  "name": "BBB Box builder",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Box product", "info": "Leave empty on the box's own product page. Choose the box when using this section on a landing page." },
    {
      "type": "select", "id": "heading_tag", "label": "Page 1 heading level", "default": "h1",
      "info": "Use H2 when the page already has a hero with an H1 (landing pages).",
      "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" } ]
    },
    { "type": "text", "id": "anchor", "label": "Anchor for links", "default": "build", "info": "Buttons can link to #build." },
    { "type": "header", "content": "Page 1 — pick sleeves (no pricing)" },
    { "type": "text", "id": "nav1", "label": "Step 1 name", "default": "Pick flavors" },
    { "type": "text", "id": "nav2", "label": "Step 2 name", "default": "Add-ons & plan" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build your box" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your 4 sleeves", "info": "Defaults to the product title when empty." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "[sleeves] sleeves of [per_sleeve] — [total] bagels. Mix up to [sleeves] flavors, or double up on your favorite.", "info": "Use [sleeves], [per_sleeve] and [total]; filled from the product." },
    { "type": "text", "id": "tray_hint", "label": "Tray hint", "default": "Each sleeve holds [per_sleeve] bagels of one flavor. Tap a sleeve to remove it." },
    { "type": "text", "id": "progress_label", "label": "Progress text", "default": "[n] of [total] sleeves selected", "info": "Use [n] and [total]." },
    { "type": "text", "id": "next_label", "label": "Next button", "default": "Next: add-ons & pricing" },
    { "type": "text", "id": "bar_next_label", "label": "Mobile bar Next button", "default": "Next" },
    { "type": "text", "id": "error_need_more", "label": "Error: box not full", "default": "Pick [remaining] more sleeve(s) to fill your box." },
    { "type": "header", "content": "Delivery check (lead capture)" },
    { "type": "checkbox", "id": "lead_enabled", "label": "Ask for name, email, phone and ZIP before page 2", "default": true, "info": "Saves a Shopify customer subscribed to email, tagged lead. Skipped for signed-in customers and after someone completes it once on this device." },
    { "type": "text", "id": "lead_source", "label": "Source tag", "default": "builder", "info": "Added as lead-<source>, e.g. lead-builder or lead-free-minis." },
    { "type": "text", "id": "lead_heading", "label": "Heading", "default": "Do we deliver to you?" },
    { "type": "text", "id": "lead_text", "label": "Intro", "default": "Enter your ZIP to check delivery, and we'll save your box so you can pick up where you left off." },
    { "type": "text", "id": "lead_button", "label": "Button", "default": "Check delivery" },
    { "type": "text", "id": "lead_sms_text", "label": "Text-message opt-in label", "default": "Text me offers and updates from Bad Boy Bagel Co. Msg & data rates may apply. Reply STOP to opt out. Not required to buy.", "info": "Leave the checkbox unticked by default (US texting law). Clear to hide." },
    {
      "type": "richtext", "id": "lead_disclosure", "label": "Disclosure under the button",
      "default": "<p>By continuing you agree to get emails from Bad Boy Bagel Co. about your box and offers. Unsubscribe anytime. <a href=\"/policies/privacy-policy\">Privacy policy</a>.</p>"
    },
    { "type": "header", "content": "Free item offer (landing pages)" },
    { "type": "product", "id": "promo_product", "label": "Free item", "info": "One unit is added free with the box as a one-time item. Only active when a discount code is set." },
    { "type": "text", "id": "promo_code", "label": "Discount code", "info": "A Buy X Get Y code in Shopify admin → Discounts that makes the free item $0. Applied automatically at checkout." },
    { "type": "text", "id": "promo_note", "label": "Page 2 note", "default": "Ships with your first box." },
    { "type": "header", "content": "Page 2 — add-ons, plan, pricing" },
    { "type": "text", "id": "back_label", "label": "Back link", "default": "Edit flavors" },
    { "type": "text", "id": "page2_heading", "label": "Heading", "default": "Finish your order" },
    { "type": "text", "id": "yourbox_title", "label": "Box summary title", "default": "Your dozen" },
    { "type": "text", "id": "step2_title", "label": "Add-ons title", "default": "Add-ons" },
    { "type": "text", "id": "step2_hint", "label": "Add-ons hint", "default": "Subscribers get add-ons in every box." },
    { "type": "text", "id": "step3_title", "label": "Order options title", "default": "How often?" },
    { "type": "text", "id": "sub_label", "label": "Subscription label", "default": "Subscribe and Save" },
    { "type": "text", "id": "sub_note", "label": "Subscription note", "default": "Cancel, pause and adjust anytime.", "info": "Make sure the Shopify Subscriptions customer portal supports each action you list." },
    { "type": "text", "id": "once_label", "label": "One-time label", "default": "One-time purchase" },
    {
      "type": "select", "id": "default_option", "label": "Pre-selected purchase option", "default": "none",
      "info": "Several state auto-renewal laws expect the customer to actively choose a subscription. Talk to counsel before pre-selecting it.",
      "options": [
        { "value": "none", "label": "None (customer chooses)" },
        { "value": "subscription", "label": "Subscribe and Save" },
        { "value": "once", "label": "One-time purchase" }
      ]
    },
    { "type": "text", "id": "error_choose_option", "label": "Error: no purchase option", "default": "Choose Subscribe and Save or a one-time purchase." },
    { "type": "text", "id": "shipping_note", "label": "Shipping note", "default": "Free shipping included." },
    { "type": "text", "id": "add_label", "label": "Checkout button", "default": "Checkout" },
    { "type": "text", "id": "bar_label", "label": "Mobile bar checkout button", "default": "Checkout" },
    {
      "type": "select", "id": "after_add", "label": "After the button", "default": "checkout",
      "options": [ { "value": "checkout", "label": "Go straight to checkout" }, { "value": "cart", "label": "Go to cart" } ]
    },
    {
      "type": "richtext", "id": "disclosure", "label": "Subscription disclosure (shown when subscribing)",
      "default": "<p>Renews automatically [frequency] at [price] (shipping included) until you cancel. Cancel anytime in your account before your next renewal. <a href=\"/policies/terms-of-service\">Subscription terms</a>.</p>",
      "info": "[price] and [frequency] are filled in live. Have counsel approve this text."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ]
}
{% endschema %}
