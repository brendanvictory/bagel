                <div class="nybe-reviews__nav">
                  <button type="button" class="nybe-reviews__arrow" data-nybe-review-prev aria-label="Previous review">{% render 'bbb-icon', name: 'chevron-right', size: 18, stroke: 2.5 %}</button>
                  <div class="nybe-reviews__dots" role="group" aria-label="Choose a review">
