            <script>
              /* Reviews carousel: auto-advances every 5s; pauses on hover/focus; stops for good once someone uses arrows, dots or swipes (they're reading); off for reduced motion */
              (function () {
                var root = document.currentScript.previousElementSibling;
                if (!root) return;
                var slides = root.querySelectorAll('[data-nybe-review]'), dots = root.querySelectorAll('[data-nybe-review-dot]');
                if (slides.length < 2) return;
                var i = 0, timer = null, paused = false, manual = false;
                var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                function show(n) {
                  i = (n + slides.length) % slides.length;
                  slides.forEach(function (s, k) { s.hidden = k !== i; });
                  dots.forEach(function (d, k) { if (k === i) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
                }
                function start() { stop(); if (!reduce && !paused && !manual) timer = setInterval(function () { if (!document.hidden) show(i + 1); }, 5000); }
                function stop() { if (timer) { clearInterval(timer); timer = null; } }
                function go(n) { manual = true; stop(); show(n); }
                root.querySelector('[data-nybe-review-next]').addEventListener('click', function () { go(i + 1); });
                root.querySelector('[data-nybe-review-prev]').addEventListener('click', function () { go(i - 1); });
                dots.forEach(function (d) { d.addEventListener('click', function () { go(Number(d.dataset.nybeReviewDot)); }); });
                root.addEventListener('mouseenter', function () { paused = true; stop(); });
                root.addEventListener('mouseleave', function () { paused = false; start(); });
                root.addEventListener('focusin', function () { paused = true; stop(); });
                root.addEventListener('focusout', function () { paused = false; start(); });
                var x0 = null;
                root.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; paused = true; stop(); }, { passive: true });
                root.addEventListener('touchend', function (e) {
                  if (x0 !== null) { var dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) go(i + (dx < 0 ? 1 : -1)); }
                  x0 = null; paused = false; start();
                });
                start();
              })();
            </script>
          {%- endif -%}
          </div>
        </aside>
        <script>
          /* Desktop: mark the sleeves tray as stuck (compact look) once it pins under the header.
             A sentinel above the tray is watched, so the tray shrinking can't toggle the state back. */
          (function () {
            var s = document.querySelector('[data-nybe-tray-sentinel]'), t = document.querySelector('[data-nybe-tray]');
            if (!s || !t) return;
            var queued = false;
            function check() {
              queued = false;
              /* Stuck = the spot right above the tray has scrolled past the sticky line under the header */
              var line = parseFloat(getComputedStyle(t).top) || 0;
              t.classList.toggle('is-stuck', getComputedStyle(t).position === 'sticky' && s.getBoundingClientRect().bottom < line - 1);
            }
            function onScroll() { if (!queued) { queued = true; requestAnimationFrame(check); } }
            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', onScroll, { passive: true });
            check();
          })();
        </script>
        <script>
          /* Delivery plan: the whole subscription card selects it, not just the top row */
          document.addEventListener('click', function (e) {
            var card = e.target.closest('[data-bbb-sub-card]');
            if (!card || e.target.closest('select, input, label, a, button')) return;
            var r = card.querySelector('input[type="radio"][data-bbb-option]');
            if (r && !r.checked) { r.checked = true; r.dispatchEvent(new Event('change', { bubbles: true })); }
          });
        </script>
        <script>
          /* Phones: expose the fixed bottom bar's height (0 when hidden) so the footer can reserve room for it */
          document.addEventListener('DOMContentLoaded', function () {
            var bar = document.querySelector('[data-bbb-bar]');
            if (!bar) return;
            function setH() { document.documentElement.style.setProperty('--bbb-bar-h', bar.offsetHeight + 'px'); }
            setH();
            window.addEventListener('resize', setH, { passive: true });
            if (window.ResizeObserver) new ResizeObserver(setH).observe(bar);
          });
        </script>
        <script>
          /* Sticky order summary: if the sidebar is taller than the screen, pin it by its bottom edge
             so every part stays reachable; it stops at the end of the left column. */
          (function () {
            var el = document.querySelector('[data-nybe-side-stick]');
            if (!el || !window.matchMedia) return;
            var mq = window.matchMedia('(min-width: 990px)');
            function fit() {
              if (!mq.matches) { el.style.removeProperty('--nybe-side-top'); return; }
              var header = 120, room = window.innerHeight - el.offsetHeight - 24;
              el.style.setProperty('--nybe-side-top', Math.min(header, room) + 'px');
            }
            fit();
            window.addEventListener('resize', fit, { passive: true });
            if (window.ResizeObserver) new ResizeObserver(fit).observe(el);
          })();
        </script>
