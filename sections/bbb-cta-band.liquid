{%- comment -%} Bad Boy Bagel Co. — Closing CTA band {%- endcomment -%}
<section
  class="bbb-cta-band color-{{ section.settings.color_scheme }} gradient{% if section.settings.spray %} bbb-spray{% endif %}"
  style="--bbb-pad-top: {{ section.settings.padding_top }}px; --bbb-pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="bbb-cta-heading-{{ section.id }}"
>
  <div class="page-width bbb-section bbb-cta-band__inner">
    <h2 id="bbb-cta-heading-{{ section.id }}" class="bbb-display bbb-display--l">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <div class="bbb-cta-row bbb-cta-row--center">
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="button button--primary">{{ section.settings.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BBB CTA band",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your dozen. Your rules." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Build your box" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "checkbox", "id": "spray", "label": "Spray-paint dots", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "BBB CTA band" } ]
}
{% endschema %}
