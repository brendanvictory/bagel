{%- comment -%} Bad Boy Bagel Co. — Closing CTA band {%- endcomment -%}
{%- liquid
  assign bg = section.settings.image
  assign has_bg = false
  if bg != blank or section.settings.bundled_bg != 'none'
    assign has_bg = true
  endif
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
-%}
<section
  class="bbb-cta-band color-{{ section.settings.color_scheme | default: 'scheme-3' }} gradient{% if section.settings.spray and has_bg == false %} bbb-spray{% endif %}{% if has_bg %} bbb-cta-band--photo{% endif %}"
  style="--bbb-pad-top: {{ section.settings.padding_top }}px; --bbb-pad-bottom: {{ section.settings.padding_bottom }}px; --bbb-overlay: {{ overlay }};"
  aria-labelledby="bbb-cta-heading-{{ section.id }}"
>
  {%- if has_bg -%}
    <div class="bbb-cta-band__bg" aria-hidden="true">
      {%- if bg != blank -%}
        {{ bg | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800', sizes: '100vw', alt: '', class: 'bbb-cta-band__img' }}
      {%- else -%}
        {%- assign bname = 'bbb-bagels-' | append: section.settings.bundled_bg -%}
        <img
          src="{{ bname | append: '-1254.webp' | asset_url }}"
          srcset="{{ bname | append: '-700.webp' | asset_url }} 700w, {{ bname | append: '-1254.webp' | asset_url }} 1254w"
          sizes="100vw" width="1254" height="1254" alt="" loading="lazy" class="bbb-cta-band__img"
        >
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="page-width bbb-section bbb-cta-band__inner">
    <h2 id="bbb-cta-heading-{{ section.id }}" class="bbb-display bbb-display--l">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <div class="bbb-cta-row bbb-cta-row--center">
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="button button--primary">{{ section.settings.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BBB CTA band",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your dozen. Your rules." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Build your box" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Background photo" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "select", "id": "bundled_bg", "label": "Bundled photo (when no image chosen)", "default": "pile",
      "options": [ { "value": "none", "label": "None (solid color)" }, { "value": "pile", "label": "Pile of bagels" }, { "value": "scatter", "label": "Bagels on white" } ]
    },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay darkness", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55 },
    { "type": "checkbox", "id": "spray", "label": "Spray-paint dots (no photo only)", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "BBB CTA band" } ]
}
{% endschema %}
