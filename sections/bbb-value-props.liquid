{%- comment -%} Bad Boy Bagel Co. — Value propositions {%- endcomment -%}
<section
  class="bbb-values color-{{ section.settings.color_scheme }} gradient"
  style="--bbb-pad-top: {{ section.settings.padding_top }}px; --bbb-pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="bbb-values-heading-{{ section.id }}"
>
  <div class="page-width bbb-section">
    <header class="bbb-section__header">
      <h2 id="bbb-values-heading-{{ section.id }}" class="bbb-display bbb-display--l">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <span class="bbb-accent">{{ section.settings.heading_accent | escape }}</span>{%- endif -%}
      </h2>
    </header>
    <ul class="bbb-values__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="bbb-card" {{ block.shopify_attributes }}>
          <h3 class="bbb-card__title">{{ block.settings.title | escape }}</h3>
          <div class="rte">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "BBB Value props",
  "tag": "div",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why go" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "bad boy" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Value" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Short, verifiable benefit.</p>", "info": "Keep claims verified: no freshness windows, origin or shipping speed unless confirmed." }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBB Value props",
      "blocks": [
        { "type": "value", "settings": { "title": "Your flavors", "text": "<p>Build the dozen you actually want. 4 sleeves, up to 4 flavors.</p>" } },
        { "type": "value", "settings": { "title": "Save every box", "text": "<p>Subscribe and pay less on every shipment. Skip or cancel from your account.</p>" } },
        { "type": "value", "settings": { "title": "Easy to stash", "text": "<p>Each flavor comes in its own sleeve of 3, so it's easy to share, stash and portion.</p>" } }
      ]
    }
  ]
}
{% endschema %}
