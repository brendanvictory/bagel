{%- comment -%} New York Bagel Express — Why us: eyebrow, heading, intro, value cards {%- endcomment -%}
<section
  id="{{ section.settings.anchor | default: 'why' | handleize }}"
  class="bbb-values{% if section.settings.layout == 'strip' %} nybe-strip{% endif %} color-{{ section.settings.color_scheme | default: 'scheme-1' }} gradient"
  style="--bbb-pad-top: {{ section.settings.padding_top }}px; --bbb-pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="bbb-values-heading-{{ section.id }}"
>
  <div class="page-width bbb-section">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.text != blank -%}
    <header class="bbb-section__header">
      {%- if section.settings.eyebrow != blank -%}<p class="bbb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="bbb-values-heading-{{ section.id }}" class="bbb-display bbb-display--l{% if section.settings.heading == blank %} bbb-sr-only{% endif %}">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <span class="bbb-accent">{{ section.settings.heading_accent | escape }}</span>{%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}<div class="rte bbb-values__intro">{{ section.settings.text }}</div>{%- endif -%}
    </header>
    {%- endif -%}
    <ul class="bbb-values__grid bbb-values__grid--n{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        <li class="bbb-card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}<span class="nybe-card__icon" aria-hidden="true">{%- render 'bbb-icon', name: block.settings.icon, size: 34, stroke: 1.6 -%}</span>{%- endif -%}
          <div class="nybe-card__body">
            <h3 class="bbb-card__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "NYBE Why us / trust row",
  "tag": "div",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why New York Bagel Express" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We know" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "bagels." },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>We have 28 retail locations and have been in the bagel business in New York for over 30 years.</p>" },
    {
      "type": "select", "id": "layout", "label": "Layout", "default": "cards",
      "options": [ { "value": "cards", "label": "Cards" }, { "value": "strip", "label": "Icon strip (trust row)" } ]
    },
    { "type": "text", "id": "anchor", "label": "Anchor for links", "default": "why", "info": "Footer and buttons can link here with /#why" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Value" },
        { "type": "richtext", "id": "text", "label": "Text (optional)", "info": "Keep claims verified." },
        { "type": "select", "id": "icon", "label": "Icon", "default": "none", "options": [
            { "value": "none", "label": "None" }, { "value": "bagel", "label": "Bagel" }, { "value": "package", "label": "Box" }, { "value": "truck", "label": "Truck" },
            { "value": "chef-hat", "label": "Chef hat" }, { "value": "flame", "label": "Oven / flame" }, { "value": "smile", "label": "Smile" }, { "value": "star", "label": "Star" },
            { "value": "leaf", "label": "Leaf" }, { "value": "map-pin", "label": "Map pin" }, { "value": "heart", "label": "Heart" }, { "value": "calendar", "label": "Calendar" },
            { "value": "clock", "label": "Clock" }, { "value": "check-circle", "label": "Check" }, { "value": "shield", "label": "Shield" }
          ] }
      ]
    }
  ],
  "presets": [ { "name": "BBB Why us" } ]
}
{% endschema %}
