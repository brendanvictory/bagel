{%- comment -%} Bad Boy Bagel Co. — How it works (numbered steps) {%- endcomment -%}
<section
  id="{{ section.settings.anchor | default: 'how-it-works' | handleize }}"
  class="bbb-steps color-{{ section.settings.color_scheme | default: 'scheme-2' }} gradient"
  style="--bbb-pad-top: {{ section.settings.padding_top }}px; --bbb-pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="bbb-steps-heading-{{ section.id }}"
>
  <div class="page-width bbb-section">
    <header class="bbb-section__header">
      {%- if section.settings.eyebrow != blank -%}<p class="bbb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="bbb-steps-heading-{{ section.id }}" class="bbb-display bbb-display--l">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <ol class="bbb-steps__list" role="list">
      {%- for block in section.blocks -%}
        <li class="bbb-steps__item" {{ block.shopify_attributes }}>
          <span class="bbb-steps__num bbb-display" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="bbb-steps__title">{{ block.settings.title | escape }}</h3>
          <div class="rte">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.cta_label != blank -%}
      <div class="bbb-cta-row bbb-cta-row--center">
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="button button--primary">{{ section.settings.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BBB How it works",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick. We bake. We ship." },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "text", "id": "anchor", "label": "Anchor for links", "default": "how-it-works" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Build your box" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this step.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBB How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Pick 3 sleeves", "text": "<p>Every dozen is 3 sleeves of 4. Choose up to 3 flavors — or go all-in on one.</p>" } },
        { "type": "step", "settings": { "title": "We bake & pack", "text": "<p>Our commissary bakes your bagels and packs each flavor in its own sleeve.</p>" } },
        { "type": "step", "settings": { "title": "We ship it to you", "text": "<p>Your box ships to your door. Subscribe and it comes back every 4 weeks.</p>" } }
      ]
    }
  ]
}
{% endschema %}
