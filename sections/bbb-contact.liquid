{%- comment -%}
  Bad Boy Bagel Co. — Contact: details + map + form
  Form posts to Shopify's built-in contact form (emails go to the store's
  sender/contact email set in Settings > Notifications). No third-party form tool.
  Map is a keyless Google Maps embed, lazy-loaded below the fold on mobile.
{%- endcomment -%}
{%- liquid
  assign address_q = section.settings.address | strip_newlines | url_encode
  assign reasons = section.settings.reasons | split: ','
-%}
<section
  id="contact"
  class="bbb-contact color-{{ section.settings.color_scheme }} gradient"
  style="--bbb-pad-top: {{ section.settings.padding_top }}px; --bbb-pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="bbb-contact-heading-{{ section.id }}"
>
  <div class="page-width bbb-section">
    <header class="bbb-section__header">
      {%- if section.settings.eyebrow != blank -%}<p class="bbb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 id="bbb-contact-heading-{{ section.id }}" class="bbb-display bbb-display--l">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <div class="bbb-contact__grid">
      <div class="bbb-contact__info">
        <div class="bbb-card bbb-contact__card">
          <h2 class="bbb-card__title">Email</h2>
          <p><a href="mailto:{{ section.settings.email }}" class="link">{{ section.settings.email | escape }}</a></p>
          {%- if section.settings.hours != blank -%}<div class="rte bbb-contact__hours">{{ section.settings.hours }}</div>{%- endif -%}
        </div>
        <div class="bbb-card bbb-contact__card">
          <h2 class="bbb-card__title">{{ section.settings.address_label | escape }}</h2>
          <address class="bbb-contact__address">{{ section.settings.address | newline_to_br }}</address>
          <p><a class="link" href="https://www.google.com/maps/search/?api=1&query={{ address_q }}" target="_blank" rel="noopener">Get directions<span class="bbb-sr-only"> (opens in a new tab)</span></a></p>
        </div>
        {%- if section.settings.show_map -%}
          <div class="bbb-contact__map">
            <iframe
              title="Map showing {{ section.settings.address | strip_newlines | escape }}"
              src="https://www.google.com/maps?q={{ address_q }}&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              width="600" height="400"
            ></iframe>
          </div>
        {%- endif -%}
      </div>

      <div class="bbb-card bbb-contact__form-wrap">
        <h2 class="bbb-card__title">{{ section.settings.form_heading | escape }}</h2>
        {%- form 'contact', id: 'BbbContactForm', class: 'bbb-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="bbb-form__success" role="status" tabindex="-1" autofocus>{{ section.settings.success | escape }}</p>
          {%- elsif form.errors -%}
            <div class="bbb-form__errors" role="alert" tabindex="-1" autofocus>
              <p><strong>Please fix the following:</strong></p>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="bbb-form__row">
            <label class="bbb-form__label" for="BbbContact-name">Name <span aria-hidden="true">*</span></label>
            <input class="bbb-form__input" id="BbbContact-name" type="text" name="contact[name]" autocomplete="name" required value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </div>
          <div class="bbb-form__row">
            <label class="bbb-form__label" for="BbbContact-phone">Phone</label>
            <input class="bbb-form__input" id="BbbContact-phone" type="tel" name="contact[phone]" autocomplete="tel" inputmode="tel" value="{{ form.phone }}">
          </div>
          <div class="bbb-form__row">
            <label class="bbb-form__label" for="BbbContact-email">Email <span aria-hidden="true">*</span></label>
            <input class="bbb-form__input" id="BbbContact-email" type="email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required
              value="{% if form.email != blank %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="BbbContact-email-error"{% endif %}>
            {%- if form.errors contains 'email' -%}
              <p id="BbbContact-email-error" class="bbb-form__field-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          </div>
          <div class="bbb-form__row">
            <label class="bbb-form__label" for="BbbContact-reason">Reason <span aria-hidden="true">*</span></label>
            <select class="bbb-form__input" id="BbbContact-reason" name="contact[reason]" required>
              <option value="" disabled selected>Choose one</option>
              {%- for r in reasons -%}
                {%- assign r = r | strip -%}
                {%- if r != blank -%}<option value="{{ r | escape }}">{{ r | escape }}</option>{%- endif -%}
              {%- endfor -%}
            </select>
          </div>
          <div class="bbb-form__row">
            <label class="bbb-form__label" for="BbbContact-body">Message</label>
            <textarea class="bbb-form__input" id="BbbContact-body" name="contact[body]" rows="5">{{ form.body }}</textarea>
          </div>
          <p class="bbb-form__req"><span aria-hidden="true">*</span> Required</p>
          <button type="submit" class="button button--primary bbb-form__submit">{{ section.settings.button | escape }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BBB Contact",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to us." },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>Questions about an order, your subscription or shipping? Reach out and our New York team will get back to you.</p>" },
    { "type": "text", "id": "email", "label": "Email", "default": "help@badboybagelco.com" },
    { "type": "richtext", "id": "hours", "label": "Hours (optional)" },
    { "type": "text", "id": "address_label", "label": "Address label", "default": "Find us" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "111 Broadway\nAmityville, NY 11701" },
    { "type": "checkbox", "id": "show_map", "label": "Show map", "default": true, "info": "Google Maps embed. It may set Google cookies — covered in the cookie/consent setup." },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send a message" },
    { "type": "text", "id": "reasons", "label": "Reasons (comma-separated)", "default": "Order question, Subscription help, Shipping & delivery, Feedback, Other" },
    { "type": "text", "id": "button", "label": "Button label", "default": "Send" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thanks! We got your message and will reply soon." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "BBB Contact" } ]
}
{% endschema %}
