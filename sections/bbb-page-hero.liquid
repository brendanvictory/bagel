{%- comment -%} Bad Boy Bagel Co. — Page hero: eyebrow, H1, intro, buttons, optional image (placeholder when empty) {%- endcomment -%}
{%- assign has_media = section.settings.show_image -%}
<section
  class="bbb-phero color-{{ section.settings.color_scheme | default: 'scheme-5' }} gradient{% if section.settings.spray %} bbb-spray{% endif %}"
  style="--bbb-pad-top: {{ section.settings.padding_top }}px; --bbb-pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="bbb-phero-{{ section.id }}"
>
  <div class="page-width bbb-section bbb-phero__grid{% unless has_media %} bbb-phero__grid--solo{% endunless %}">
    <div class="bbb-phero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="bbb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 id="bbb-phero-{{ section.id }}" class="bbb-display bbb-display--xl">
        {{ section.settings.heading | default: page.title | escape }}
        {%- if section.settings.heading_accent != blank %} <span class="bbb-accent">{{ section.settings.heading_accent | escape }}</span>{%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}<div class="rte bbb-phero__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
        <div class="bbb-cta-row">
          {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_link | default: '/products/build-your-box' }}" class="button button--primary">{{ section.settings.cta_label | escape }}</a>{%- endif -%}
          {%- if section.settings.cta2_label != blank -%}<a href="{{ section.settings.cta2_link | default: '#' }}" class="button button--secondary">{{ section.settings.cta2_label | escape }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if has_media -%}
      <div class="bbb-phero__media">
        {%- render 'bbb-image-placeholder', image: section.settings.image, alt: section.settings.image_alt, sizes: '(min-width: 990px) 45vw, 100vw', ratio: '4 / 3', eager: true -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BBB Page hero",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Uses the page title when empty." },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (Carolina blue)" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "text", "id": "cta_label", "label": "Primary button label" },
    { "type": "url", "id": "cta_link", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link" },
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "A placeholder shows until you choose one." },
    { "type": "text", "id": "image_alt", "label": "Image description (alt text)" },
    { "type": "checkbox", "id": "spray", "label": "Spray-paint dots", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "BBB Page hero" } ]
}
{% endschema %}
