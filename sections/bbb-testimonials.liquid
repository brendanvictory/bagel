{%- comment -%}
  Bad Boy Bagel Co. — Testimonials
  Genuine, approved customer quotes only. Renders nothing until at least
  one quote block is added.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section
    class="bbb-quotes color-{{ section.settings.color_scheme }} gradient"
    style="--bbb-pad-top: {{ section.settings.padding_top }}px; --bbb-pad-bottom: {{ section.settings.padding_bottom }}px;"
    aria-labelledby="bbb-quotes-heading-{{ section.id }}"
  >
    <div class="page-width bbb-section">
      <header class="bbb-section__header">
        <h2 id="bbb-quotes-heading-{{ section.id }}" class="bbb-display bbb-display--l">{{ section.settings.heading | escape }}</h2>
      </header>
      <ul class="bbb-quotes__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="bbb-card" {{ block.shopify_attributes }}>
            <figure>
              <blockquote class="bbb-quotes__text">{{ block.settings.quote }}</blockquote>
              <figcaption class="bbb-quotes__who">
                {{ block.settings.name | escape }}{% if block.settings.location != blank %}, {{ block.settings.location | escape }}{% endif %}
              </figcaption>
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="page-width"><p class="bbb-editor-note">Testimonials are hidden until you add a real, approved customer quote.</p></div>
{%- endif -%}

{% schema %}
{
  "name": "BBB Testimonials",
  "tag": "div",
  "class": "section",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people are saying" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote", "info": "Real customer words only, with their permission." },
        { "type": "text", "id": "name", "label": "Name (e.g., first name + initial)" },
        { "type": "text", "id": "location", "label": "Location (optional)" }
      ]
    }
  ],
  "presets": [ { "name": "BBB Testimonials" } ]
}
{% endschema %}
