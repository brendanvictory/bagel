{%- comment -%}
  Bad Boy Bagel Co. — Testimonials (auto-scrolling)
  - Genuine, approved customer quotes only (blocks).
  - Scrolls continuously; pauses on hover/focus and with a visible Pause button
    (WCAG 2.2.2). With prefers-reduced-motion it becomes a swipeable row.
  - With no quotes added: hidden on the storefront; in the Theme Editor it shows
    clearly labeled SAMPLE cards so the layout can be reviewed.
{%- endcomment -%}
{%- liquid
  assign show_samples = false
  if section.blocks.size == 0 and request.design_mode
    assign show_samples = true
  endif
-%}
{%- if section.blocks.size > 0 or show_samples -%}
  <section
    id="{{ section.settings.anchor | default: 'reviews' | handleize }}"
    class="bbb-quotes color-{{ section.settings.color_scheme }} gradient"
    style="--bbb-pad-top: {{ section.settings.padding_top }}px; --bbb-pad-bottom: {{ section.settings.padding_bottom }}px; --bbb-marquee-duration: {{ section.settings.speed }}s;"
    aria-labelledby="bbb-quotes-heading-{{ section.id }}"
  >
    <div class="page-width bbb-section bbb-quotes__head">
      <header class="bbb-section__header">
        {%- if section.settings.eyebrow != blank -%}<p class="bbb-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="bbb-quotes-heading-{{ section.id }}" class="bbb-display bbb-display--l">{{ section.settings.heading | escape }}</h2>
      </header>
      <button type="button" class="bbb-marquee__toggle" data-bbb-marquee-toggle>
        <span class="bbb-marquee__toggle-pause">Pause</span><span class="bbb-marquee__toggle-play">Play</span>
        <span class="bbb-sr-only">scrolling reviews</span>
      </button>
    </div>

    {%- capture cards -%}
      {%- if show_samples -%}
        {%- for i in (1..4) -%}
          <li class="bbb-quote-card bbb-quote-card--sample">
            <figure>
              <p class="bbb-quote-card__sample">Sample — replace with a real review</p>
              <blockquote class="bbb-quote-card__text"><p>Customer quote goes here. Add a Quote block with real words from a real customer.</p></blockquote>
              <figcaption class="bbb-quote-card__who">First name L., City</figcaption>
            </figure>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <li class="bbb-quote-card" {{ block.shopify_attributes }}>
            <figure>
              {%- if block.settings.rating > 0 -%}
                <p class="bbb-quote-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {%- for s in (1..5) -%}<span aria-hidden="true">{% if s <= block.settings.rating %}★{% else %}☆{% endif %}</span>{%- endfor -%}
                </p>
              {%- endif -%}
              <blockquote class="bbb-quote-card__text">{{ block.settings.quote }}</blockquote>
              <figcaption class="bbb-quote-card__who">
                {{ block.settings.name | escape }}{% if block.settings.location != blank %}, {{ block.settings.location | escape }}{% endif %}
              </figcaption>
            </figure>
          </li>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}

    <div class="bbb-marquee" data-bbb-marquee>
      <ul class="bbb-marquee__track" role="list">{{ cards }}</ul>
      <ul class="bbb-marquee__track bbb-marquee__track--clone" role="list" aria-hidden="true">{{ cards }}</ul>
    </div>
  </section>
  <script src="{{ 'bbb-marquee.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "BBB Testimonials",
  "tag": "div",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Testimonials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people are saying" },
    { "type": "range", "id": "speed", "label": "Scroll duration (seconds per loop)", "min": 20, "max": 120, "step": 5, "unit": "s", "default": 50 },
    { "type": "text", "id": "anchor", "label": "Anchor for links", "default": "reviews" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote", "info": "Real customer words only, with their permission." },
        { "type": "text", "id": "name", "label": "Name (e.g., first name + initial)" },
        { "type": "text", "id": "location", "label": "Location (optional)" },
        { "type": "range", "id": "rating", "label": "Star rating (0 hides stars)", "min": 0, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [ { "name": "BBB Testimonials" } ]
}
{% endschema %}
