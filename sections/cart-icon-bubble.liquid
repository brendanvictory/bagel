{% if cart == empty %}
  <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
{% else %}
  <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
{% endif %}

<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- if cart != empty -%}
  <div class="cart-count-bubble">
    {%- capture bbb_n -%}{% render 'bbb-cart-count' %}{%- endcapture -%}{%- assign bbb_n = bbb_n | plus: 0 -%}
{%- if bbb_n < 100 -%}
      <span aria-hidden="true">{{ bbb_n }}</span>
    {%- endif -%}
    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: bbb_n }}</span>
  </div>
{%- endif -%}
